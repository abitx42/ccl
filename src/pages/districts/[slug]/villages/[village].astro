---
import VillagePage from '../../../../components/pages/VillagePage.astro';
import { getDistricts, getVillages } from '../../../../lib/content';

export function getStaticPaths() {
  return getDistricts().flatMap(district =>
    getVillages(district.slug).map(village => ({
      params: { slug: district.slug, village: village.slug },
      props: { district, village }
    }))
  );
}

const { district, village } = Astro.props;
---

<VillagePage district={district} village={village} lang="mr" />
