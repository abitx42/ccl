---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  getDistricts,
  getVillages,
  getSurveys,
  getSpecies,
  getChallenges,
  getPeople
} from '../../../../lib/content';

export async function getStaticPaths() {
  const districts = getDistricts();
  const paths: any[] = [];

  for (const d of districts) {
    const villages = getVillages(d.slug);
    for (const v of villages) {
      paths.push({
        params: { slug: d.slug, village: v.slug },
        props: { district: d, village: v }
      });
    }
  }

  return paths;
}

const { slug, village: villageSlug } = Astro.params;
const { district, village } = Astro.props;
const lang = (Astro.currentLocale || 'en') as 'en' | 'mr' | 'hi';

const surveys = getSurveys(village.id, slug!, villageSlug!);
const speciesList = getSpecies(village.id, slug!, villageSlug!);
const challenges = getChallenges(village.id, slug!, villageSlug!);
const people = getPeople(village.people);

const vName = village.name[lang] || village.name.en;
const dName = district.name[lang] || district.name.en;

const labels = {
  en: {
    back: `← Back to ${dName} District`,
    idBadge: 'Opaque Record ID',
    adminDist: 'Administrative District',
    researchDist: 'Research District',
    communityType: 'Community Type',
    aboutDoc: 'Documented Source',
    aboutComm: 'Community Oral Account',
    howToReach: 'How to Reach / Access Corridor',
    surveysTitle: 'Aggregated Climate Audits & Field Surveys',
    speciesTitle: 'Verified Flora & Fauna Observations',
    challengesTitle: 'Ecological Challenges & Co-Designed Interventions',
    peopleTitle: 'Local Leadership & Facilitators (Consent-Verified)',
    visitCtaTitle: 'Visiting Respectfully & Research Access',
    visitCtaDesc: 'Visits are subject to a two-tier review process (University Review + Gram Panchayat / Community sign-off). This is strictly research access, not open tourism.',
    visitCtaBtn: 'Submit Research Access Request',
    evidenceLink: 'Verified via Evidence'
  },
  mr: {
    back: `← ${dName} जिल्हा पृष्ठावर परत जा`,
    idBadge: 'नोंदणी आयडी',
    adminDist: 'प्रशासकीय जिल्हा',
    researchDist: 'संशोधन जिल्हा',
    communityType: 'समुदाय प्रकार',
    aboutDoc: 'अधिकृत नोंद',
    aboutComm: 'स्थानिक माहिती / मौखिक इतिहास',
    howToReach: 'कसे पोहोचावे',
    surveysTitle: 'एकत्रित हवामान सर्वेक्षणे व अहवाल',
    speciesTitle: 'स्थानिक जैवविविधता नोंदी',
    challengesTitle: 'पर्यावरणीय आव्हाने आणि सह-रचित उपाय',
    peopleTitle: 'स्थानिक नेतृत्व व मार्गदर्शक (संमती प्राप्त)',
    visitCtaTitle: 'अभ्यास भेट परवानगी आणि आचारसंहिता',
    visitCtaDesc: 'अभ्यास भेटींसाठी दोन टप्प्यांची परवानगी आवश्यक आहे (विद्यापीठ व ग्रामपंचायत संमती). ही निव्वळ संशोधन भेट आहे, पर्यटन नव्हे.',
    visitCtaBtn: 'अभ्यास भेट अर्ज सादर करा',
    evidenceLink: 'सत्यापित पुरावा'
  },
  hi: {
    back: `← ${dName} जिला पृष्ठ पर वापस जाएं`,
    idBadge: 'रिकॉर्ड आईडी',
    adminDist: 'प्रशासनिक जिला',
    researchDist: 'अनुसंधान जिला',
    communityType: 'समुदाय प्रकार',
    aboutDoc: 'दस्तावेजी स्रोत',
    aboutComm: 'सामुदायिक मौखिक वृत्तांत',
    howToReach: 'कैसे पहुंचें',
    surveysTitle: 'एकत्रित जलवायु ऑडिट एवं क्षेत्रीय सर्वेक्षण',
    speciesTitle: 'सत्यापित वनस्पति एवं जीव अवलोकन',
    challengesTitle: 'पारिस्थितिक चुनौतियां एवं सह-निर्मित समाधान',
    peopleTitle: 'स्थानीय नेतृत्व एवं सूत्रधार (सहमति-सत्यापित)',
    visitCtaTitle: 'शोध पहुंच अनुरोध एवं आचार संहिता',
    visitCtaDesc: 'यात्राओं के लिए दो-स्तरीय समीक्षा प्रक्रिया आवश्यक है (विश्वविद्यालय + ग्राम पंचायत)। यह केवल शोध पहुंच है, पर्यटन नहीं।',
    visitCtaBtn: 'शोध पहुंच अनुरोध पत्र भरें',
    evidenceLink: 'सत्यापित साक्ष्य'
  }
};

const t = labels[lang] || labels.en;
---

<BaseLayout title={`${vName} | ${dName}`} theme={district.theme} lang={lang}>
  <!-- Village Header -->
  <section class="py-12 bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href={`/districts/${district.slug}`} class="text-xs font-semibold text-[var(--color-primary)] hover:underline">
          {t.back}
        </a>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
          <div class="flex items-center space-x-3 mb-2">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] uppercase">
              {village.community_type}
            </span>
            <span class="font-mono text-xs px-2 py-0.5 rounded bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-muted)]">
              {village.id}
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)]">
            {vName}
          </h1>
          <p class="text-xs text-[var(--color-text-muted)] mt-1 font-mono">
            {t.adminDist}: {village.geography.administrative_district} · {t.researchDist}: {village.project.research_district}
          </p>
        </div>

        {village.coordinates && (
          <div class="p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-xs">
            <span class="block text-[var(--color-text-muted)] font-medium">Coarse Coordinates (Protected)</span>
            <span class="font-mono text-[var(--color-text-main)]">{village.coordinates.lat}° N, {village.coordinates.lng}° E</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Village Details & Context -->
  <section class="py-12 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- About Grid (Separating Documented Source from Community Account) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {village.about?.documented_source && (
          <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] mb-3">
              📖 {t.aboutDoc}
            </h3>
            <p class="text-sm text-[var(--color-text-main)] leading-relaxed">
              {village.about.documented_source[lang] || village.about.documented_source.en}
            </p>
          </div>
        )}

        {village.about?.community_account && (
          <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] mb-3">
              🗣️ {t.aboutComm}
            </h3>
            <p class="text-sm text-[var(--color-text-main)] leading-relaxed">
              {village.about.community_account[lang] || village.about.community_account.en}
            </p>
          </div>
        )}
      </div>

      <!-- SECTION 1: Surveys (Only shown if records exist) -->
      {surveys.length > 0 && (
        <div class="pt-8 border-t border-[var(--color-border)]">
          <div class="mb-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">Field Data</h2>
            <p class="text-2xl font-extrabold text-[var(--color-text-main)] mt-1">{t.surveysTitle}</p>
          </div>

          <div class="grid grid-cols-1 gap-6">
            {surveys.map(s => {
              const sTitle = s.title[lang] || s.title.en;
              const sDesc = s.sample.description[lang] || s.sample.description.en;

              return (
                <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] space-y-4">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[var(--color-border)]">
                    <div>
                      <span class="font-mono text-xs text-[var(--color-text-muted)] mr-3">{s.id}</span>
                      <span class="px-2 py-0.5 text-xs font-semibold rounded bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] uppercase">
                        {s.method}
                      </span>
                    </div>
                    <span class="text-xs text-[var(--color-text-muted)] mt-1 sm:mt-0 font-medium">
                      {s.dates.start} to {s.dates.end} · Sample size: {s.sample.n}
                    </span>
                  </div>

                  <h3 class="text-lg font-bold text-[var(--color-text-main)]">{sTitle}</h3>
                  <p class="text-xs text-[var(--color-text-muted)] italic">{sDesc}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                    {s.findings.map(f => (
                      <div class="p-4 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs space-y-2">
                        <span class="font-bold text-[var(--color-primary)] uppercase tracking-wider block">
                          {f.indicator.replace(/_/g, ' ')}
                        </span>
                        <p class="text-[var(--color-text-main)] leading-relaxed">
                          {f.text[lang] || f.text.en}
                        </p>
                        {f.metrics && (
                          <div class="pt-2 border-t border-[var(--color-border)] font-mono text-[11px] text-[var(--color-text-muted)]">
                            {Object.entries(f.metrics).map(([k, v]) => (
                              <span class="mr-3">{k}: <strong class="text-[var(--color-text-main)]">{v}</strong></span>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- SECTION 2: Flora & Fauna (Only shown if records exist) -->
      {speciesList.length > 0 && (
        <div class="pt-8 border-t border-[var(--color-border)]">
          <div class="mb-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">Biodiversity</h2>
            <p class="text-2xl font-extrabold text-[var(--color-text-main)] mt-1">{t.speciesTitle}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {speciesList.map(sp => {
              const cName = sp.common_name[lang] || sp.common_name.en;
              const habText = sp.habitat[lang] || sp.habitat.en;

              return (
                <div class="p-5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">
                      {sp.kind.toUpperCase()} · IUCN {sp.iucn_status}
                    </span>
                    <span class="font-mono text-xs text-[var(--color-text-muted)]">{sp.id}</span>
                  </div>

                  <div>
                    <h4 class="text-base font-bold text-[var(--color-text-main)]">{cName}</h4>
                    <p class="text-xs italic font-serif text-[var(--color-text-muted)]">{sp.scientific_name}</p>
                  </div>

                  <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{habText}</p>

                  <div class="pt-2 border-t border-[var(--color-border)] text-[11px] text-[var(--color-text-muted)]">
                    Observed on {sp.observed_on} by {sp.observed_by}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- SECTION 3: Challenges & Interventions (Only shown if records exist) -->
      {challenges.length > 0 && (
        <div class="pt-8 border-t border-[var(--color-border)]">
          <div class="mb-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">Climate Resilience</h2>
            <p class="text-2xl font-extrabold text-[var(--color-text-main)] mt-1">{t.challengesTitle}</p>
          </div>

          <div class="grid grid-cols-1 gap-6">
            {challenges.map(ch => {
              const chTitle = ch.title[lang] || ch.title.en;
              const chObs = ch.observed_by_researchers[lang] || ch.observed_by_researchers.en;
              const chComm = ch.community_perspectives?.[lang] || ch.community_perspectives?.en;

              return (
                <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] space-y-4">
                  <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
                    <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-900 uppercase">
                      Category: {ch.category}
                    </span>
                    <span class="font-mono text-xs text-[var(--color-text-muted)]">{ch.id}</span>
                  </div>

                  <h3 class="text-lg font-bold text-[var(--color-text-main)]">{chTitle}</h3>
                  <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{chObs}</p>

                  {chComm && (
                    <div class="p-3 rounded-md bg-[var(--color-surface-subtle)] text-xs text-[var(--color-text-muted)] border-l-2 border-[var(--color-primary)]">
                      <strong class="text-[var(--color-text-main)]">Community Perspective:</strong> {chComm}
                    </div>
                  )}

                  {ch.interventions && ch.interventions.length > 0 && (
                    <div class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-3">
                      <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-main)]">
                        Co-Designed Interventions & Measured Outcomes
                      </h4>
                      {ch.interventions.map(it => (
                        <div class="p-4 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs space-y-2">
                          <div class="flex items-center space-x-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-100 text-blue-900">
                              {it.type.toUpperCase()} INTERVENTION
                            </span>
                          </div>
                          <p class="text-[var(--color-text-main)]">{it.description[lang] || it.description.en}</p>
                          {it.outcome && (
                            <div class="pt-2 border-t border-[var(--color-border)] text-xs text-emerald-800 font-medium">
                              <strong>Measured Outcome ({it.outcome.as_of}):</strong> {it.outcome.measured[lang] || it.outcome.measured.en}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- SECTION 4: People (Strict Consent Gated - only rendered if consent.state === 'granted') -->
      {people.length > 0 && (
        <div class="pt-8 border-t border-[var(--color-border)]">
          <div class="mb-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">Community Leadership</h2>
            <p class="text-2xl font-extrabold text-[var(--color-text-main)] mt-1">{t.peopleTitle}</p>
          </div>

          <div class={`grid gap-6 ${people.length <= 3 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4'}`}>
            {people.map(p => {
              const pName = p.name[lang] || p.name.en;
              const pBio = p.bio?.[lang] || p.bio?.en || '';
              const pRole = typeof p.role === 'string' ? p.role : (p.role[lang] || p.role.en);

              return (
                <div class="p-5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] flex flex-col justify-between shadow-xs">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)]">
                        {pRole}
                      </span>
                      <span class="text-[11px] font-mono text-emerald-700">✓ Consented</span>
                    </div>

                    {p.photo && (
                      <div class="rounded-lg overflow-hidden border border-[var(--color-border)]">
                        <img src={p.photo} alt={p.photo_alt?.[lang] || p.photo_alt?.en || pName} class="w-full h-40 object-cover" />
                        {p.photo_credit && (
                          <div class="p-1.5 text-[10px] text-[var(--color-text-muted)] bg-[var(--color-surface-subtle)] text-right">
                            Photo by {p.photo_credit}
                          </div>
                        )}
                      </div>
                    )}

                    <h4 class="text-base font-bold text-[var(--color-text-main)]">{pName}</h4>
                    {pBio && <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{pBio}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- SECTION 5: Research Access / Visit Request CTA -->
      <div class="pt-8 border-t border-[var(--color-border)]">
        <div class="p-8 rounded-2xl bg-gradient-to-r from-[var(--color-surface-subtle)] to-[var(--color-surface)] border border-[var(--color-border)] shadow-sm">
          <div class="max-w-2xl">
            <h3 class="text-xl font-bold text-[var(--color-text-main)]">{t.visitCtaTitle}</h3>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mt-2">
              {t.visitCtaDesc}
            </p>
            <div class="mt-6">
              <a
                href={`/visit?district=${district.slug}&village=${village.slug}`}
                class="inline-flex items-center px-5 py-2.5 rounded-lg text-xs font-semibold bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] transition shadow-xs"
              >
                <span>{t.visitCtaBtn}</span>
                <span class="ml-2">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
