---
import DistrictPage from '../../components/pages/DistrictPage.astro';
import { getDistricts } from '../../lib/content';

export function getStaticPaths() {
  return getDistricts().map(district => ({
    params: { slug: district.slug },
    props: { district }
  }));
}

const { district } = Astro.props;
---

<DistrictPage district={district} lang="mr" />
