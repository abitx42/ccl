---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDistricts } from '../lib/content';

const lang = (Astro.currentLocale || 'en') as 'en' | 'mr' | 'hi';
const districts = getDistricts();

const selectedDistrict = Astro.url.searchParams.get('district') || '';

const text = {
  en: {
    title: 'Community Visits & Research Access',
    subtitle: 'This is strictly research access and academic exchange, not open tourism. All requests undergo two-stage review by the University of Mumbai and the respective Gram Panchayat / local community.',
    codeTitle: 'Visiting Respectfully & Code of Conduct',
    codePoints: [
      'Visit only at agreed times and places; stay with the assigned academic/community guide.',
      'Ask before photographing people, homes or ceremonies; never photograph children without explicit written guardian consent.',
      'Do not collect flora, fauna, archaeological artefacts, or soil samples without authorized scientific permits.',
      'Respect local customs, quiet hours, and sacred groves; leave zero waste behind.',
      'Do not share exact GPS coordinates of sensitive village sites without written clearance.'
    ],
    formTitle: 'Submit Research Access Application',
    name: 'Full Name',
    email: 'Institutional Email Address',
    phone: 'Phone Number (Optional)',
    institution: 'Institution / Organization Name',
    institutionType: 'Institution Type',
    purpose: 'Purpose of Visit',
    details: 'Details of Proposed Research & Learning Objectives',
    districtSelect: 'Target Research District',
    dates: 'Proposed Dates',
    groupSize: 'Group Size',
    consentCheck: 'I agree to strictly abide by the Code of Conduct and acknowledge that the Gram Panchayat and University hold final approval authority.'
  },
  mr: {
    title: 'अभ्यास भेट परवानगी आणि आचारसंहिता',
    subtitle: 'ही निव्वळ शैक्षणिक आणि संशोधन भेट आहे, पर्यटन नव्हे. सर्व अर्जांची पडताळणी मुंबई विद्यापीठ आणि स्थानिक ग्रामपंचायतीद्वारे केली जाते.',
    codeTitle: 'आदरपूर्वक भेट आणि आचारसंहिता',
    codePoints: [
      'केवळ ठरलेल्या वेळेत आणि ठिकाणीच भेट द्या; नियुक्त मार्गदर्शकासोबत रहा.',
      'परवानगीशिवाय व्यक्ती, घरे किंवा विधींची छायाचित्रे काढू नका; मुलांचे फोटो घेऊ नका.',
      'परवानगीशिवाय वनस्पती, प्राणी किंवा मातीचे नमुने गोळा करू नका.',
      'स्थानिक संस्कृती आणि पवित्र देवरायांचा आदर राखा; कोणताही कचरा करू नका.',
      'संवेदनशील ठिकाणांचे जीपीएस स्थान परवानगीशिवाय सार्वजनिक करू नका.'
    ],
    formTitle: 'अभ्यास भेट अर्ज',
    name: 'पूर्ण नाव',
    email: 'ईमेल पत्ता',
    phone: 'फोन नंबर (पर्यायी)',
    institution: 'संस्थेचे नाव',
    institutionType: 'संस्थेचा प्रकार',
    purpose: 'भेटीचा उद्देश',
    details: 'संशोधन उद्देशांचे सविस्तर वर्णन',
    districtSelect: 'संशोधन जिल्हा',
    dates: 'प्रस्तावित तारीख',
    groupSize: 'सहभागींची संख्या',
    consentCheck: 'मी आचारसंहितेचे पालन करण्यास बांधील आहे आणि विद्यापीठ व ग्रामपंचायतीचा निर्णय अंतिम असेल हे मान्य करतो.'
  },
  hi: {
    title: 'शोध पहुंच अनुरोध एवं आचार संहिता',
    subtitle: 'यह विशुद्ध रूप से शैक्षणिक एवं शोध विनिमय है, खुला पर्यटन नहीं। सभी अनुरोधों की समीक्षा मुंबई विश्वविद्यालय और संबंधित ग्राम पंचायत द्वारा की जाती है।',
    codeTitle: 'आचार संहिता एवं दिशानिर्देश',
    codePoints: [
      'केवल तय समय और स्थान पर जाएं; निर्दिष्ट मार्गदर्शक के साथ रहें।',
      'बिना सहमति किसी व्यक्ति, घर या अनुष्ठान की तस्वीरें न लें; बच्चों की तस्वीरें न लें।',
      'वैधानिक अनुमति के बिना पौधे, जीव या मिट्टी के नमूने न लें।',
      'स्थानीय रीति-रिवाजों और पवित्र उपवनों का सम्मान करें; कचरा न फैलाएं।',
      'संवेदनशील स्थानों के सटीक जीपीएस निर्देशांक साझा न करें।'
    ],
    formTitle: 'शोध पहुंच आवेदन पत्र',
    name: 'पूरा नाम',
    email: 'ईमेल पता',
    phone: 'फोन नंबर (वैकल्पिक)',
    institution: 'संस्थान का नाम',
    institutionType: 'संस्थान का प्रकार',
    purpose: 'भेंट का उद्देश्य',
    details: 'प्रस्तावित शोध उद्देश्यों का विवरण',
    districtSelect: 'अनुसंधान जिला',
    dates: 'प्रस्तावित तिथियां',
    groupSize: 'समूह आकार',
    consentCheck: 'मैं आचार संहिता का पालन करने के लिए सहमत हूं तथा स्वीकार करता हूं कि विश्वविद्यालय एवं ग्राम पंचायत का निर्णय अंतिम होगा।'
  }
};

const t = text[lang] || text.en;
---

<BaseLayout title="Research Access" lang={lang}>
  <section class="py-16 bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] mb-3">
          Ethical Fieldwork Protocol
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)]">
          {t.title}
        </h1>
        <p class="mt-4 text-sm text-[var(--color-text-muted)] leading-relaxed">
          {t.subtitle}
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Code of Conduct Box -->
      <div class="p-6 sm:p-8 rounded-xl bg-[var(--color-surface)] border-2 border-amber-200 shadow-xs">
        <h2 class="text-lg font-bold text-amber-950 mb-4 flex items-center">
          <span class="mr-2 text-xl">📜</span> {t.codeTitle}
        </h2>
        <ul class="space-y-2.5 text-xs text-[var(--color-text-muted)] leading-relaxed">
          {t.codePoints.map(pt => (
            <li class="flex items-start">
              <span class="text-amber-700 mr-2 font-bold">•</span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Application Form (Simulated client submission with zero secret exposure) -->
      <div class="p-6 sm:p-8 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs">
        <h2 class="text-xl font-bold text-[var(--color-text-main)] mb-6">
          {t.formTitle}
        </h2>

        <form class="space-y-6" onsubmit="alert('Request submitted for Stage 1 (University) review. You will receive an email confirmation.'); return false;">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-[var(--color-text-main)] mb-1.5">{t.name} *</label>
              <input type="text" required class="w-full px-3 py-2 text-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] focus:bg-[var(--color-surface)]" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-[var(--color-text-main)] mb-1.5">{t.email} *</label>
              <input type="email" required class="w-full px-3 py-2 text-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] focus:bg-[var(--color-surface)]" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-[var(--color-text-main)] mb-1.5">{t.institution} *</label>
              <input type="text" required class="w-full px-3 py-2 text-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] focus:bg-[var(--color-surface)]" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-[var(--color-text-main)] mb-1.5">{t.districtSelect} *</label>
              <select class="w-full px-3 py-2 text-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] focus:bg-[var(--color-surface)]">
                {districts.map(d => (
                  <option value={d.slug} selected={d.slug === selectedDistrict}>
                    {d.name[lang] || d.name.en}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-text-main)] mb-1.5">{t.details} *</label>
            <textarea rows="4" required class="w-full px-3 py-2 text-xs rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] focus:bg-[var(--color-surface)]"></textarea>
          </div>

          <div class="flex items-start">
            <input type="checkbox" id="conduct-agree" required class="mt-1 h-4 w-4 rounded border-gray-300 text-[var(--color-primary)] focus:ring-[var(--color-primary)]" />
            <label for="conduct-agree" class="ml-2.5 text-xs text-[var(--color-text-muted)] leading-relaxed">
              {t.consentCheck}
            </label>
          </div>

          <button
            type="submit"
            class="px-6 py-2.5 rounded-lg text-xs font-semibold bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] transition shadow-xs"
          >
            Submit Access Application →
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
