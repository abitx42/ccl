---
import SourcesPage from '../../components/pages/SourcesPage.astro';
import { locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.filter(locale => locale !== 'mr').map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Exclude<Locale, 'mr'>;
---

<SourcesPage lang={lang} />
