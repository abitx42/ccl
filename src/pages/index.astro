---
import BaseLayout from '../layouts/BaseLayout.astro';
import CCLStory from '../components/story/CCLStory.astro';
import StatsCounter from '../components/StatsCounter.astro';
import DistrictCard from '../components/DistrictCard.astro';
import { getDistricts } from '../lib/content';

const lang = (Astro.currentLocale || 'en') as 'en' | 'mr' | 'hi';
const districts = getDistricts();

const content = {
  en: {
    partnersTitle: 'Institutional & Funding Partners',
    partnersSub: 'Formal Bilateral Consortium',
    districtsTitle: 'Explore the CCL Research Archive',
    districtsDesc: 'Navigate verified coastal field laboratories, community audits, and local resilience initiatives.'
  },
  mr: {
    partnersTitle: 'संस्थात्मक आणि निधी भागीदार',
    partnersSub: 'अधिकृत द्विपक्षीय संशोधन मंच',
    districtsTitle: 'संशोधन संग्रह शोधा',
    districtsDesc: 'सत्यापित किनारपट्टी क्षेत्रीय प्रयोगशाळा, समुदाय सर्वेक्षणे आणि स्थानिक उपाययोजना पहा.'
  },
  hi: {
    partnersTitle: 'संस्थागत एवं वित्तपोषण भागीदार',
    partnersSub: 'द्विपक्षीय अनुसंधान संघ',
    districtsTitle: 'अनुसंधान पुरालेख देखें',
    districtsDesc: 'सत्यापित तटीय क्षेत्रीय प्रयोगशालाएं, सामुदायिक ऑडिट और स्थानीय समाधान खोजें।'
  }
};

const t = content[lang] || content.en;
---

<BaseLayout title="Home" lang={lang}>
  <!-- B0 to B6: Real Semantic HTML Story & Narrative with Tier 3 2D Canvas & Tier 4 Static Vector -->
  <CCLStory lang={lang} />

  <!-- B7: Build-Time Computed Research Statistics (Auto-hidden if 0 verified records) -->
  <StatsCounter lang={lang} />

  <!-- B8: Institutional Partners Logo & Role Strip -->
  <section class="py-16 bg-[var(--color-surface)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)] mb-1">
        {t.partnersSub}
      </h2>
      <p class="text-xl font-extrabold text-[var(--color-text-main)] mb-10">
        {t.partnersTitle}
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center max-w-4xl mx-auto">
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
          <span class="block text-xs font-bold uppercase text-[var(--color-text-main)]">University of Mumbai</span>
          <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">Centre for Climate Change (CCCSS)</span>
        </div>
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
          <span class="block text-xs font-bold uppercase text-[var(--color-text-main)]">British Council</span>
          <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">Climate Skills India Programme</span>
        </div>
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
          <span class="block text-xs font-bold uppercase text-[var(--color-text-main)]">HSBC Global CSR</span>
          <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">Transition Grantor</span>
        </div>
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
          <span class="block text-xs font-bold uppercase text-[var(--color-text-main)]">University of Bristol</span>
          <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">UK Research Partner</span>
        </div>
      </div>
    </div>
  </section>

  <!-- B9: District Selector Section (Real HTML <a> Links, Data-Driven, Zero Hardcoded Counts) -->
  <section id="districts" class="py-20 bg-[var(--color-bg)] scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)]">Research Cartography</h2>
        <p class="mt-2 text-3xl font-extrabold text-[var(--color-text-main)]">{t.districtsTitle}</p>
        <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">{t.districtsDesc}</p>
      </div>

      <!-- Data-driven district grid (Never hard-coded, derived directly from content) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {districts.map(d => (
          <DistrictCard district={d} lang={lang} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
