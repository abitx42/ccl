---
import type { District } from '../lib/content';
import { localizedHref } from '../lib/i18n';

interface Props {
  district: District;
  lang?: 'en' | 'mr' | 'hi';
}

const { district, lang = 'en' } = Astro.props;

const name = district.name[lang] || district.name.en;
const tagline = district.tagline[lang] || district.tagline.en;
const linkUrl = localizedHref(lang, `/districts/${district.slug}`);

const exploreText = {
  en: 'Explore Research Portal',
  mr: 'संशोधन पोर्टल उघडा',
  hi: 'अनुसंधान पोर्टल देखें'
}[lang] || 'Explore Research Portal';

const referenceText = {
  en: 'Technical Reference Implementation',
  mr: 'तांत्रिक संदर्भ अंमलबजावणी',
  hi: 'तकनीकी संदर्भ कार्यान्वयन'
}[lang] || 'Technical Reference Implementation';
---

<div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group">
  <div class="h-48 bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] relative overflow-hidden flex items-center justify-center p-6">
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10"></div>
    <div class="relative z-20 text-white text-center">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-sm mb-2">
         {referenceText}
      </span>
      <h3 class="text-2xl font-bold tracking-tight">{name}</h3>
    </div>
  </div>

  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        {tagline}
      </p>

      {district.highlights && district.highlights.length > 0 && (
        <ul class="mt-4 space-y-2 text-xs text-[var(--color-text-main)]">
          {district.highlights.map(h => (
            <li class="flex items-start">
              <span class="text-[var(--color-primary)] mr-2">✦</span>
              <span>{h[lang] || h.en}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="pt-4 border-t border-[var(--color-border)]">
      <a
        href={linkUrl}
        class="inline-flex items-center justify-center w-full px-4 py-2 text-sm font-semibold rounded-lg bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] transition"
      >
        <span>{exploreText}</span>
        <span class="ml-2">→</span>
      </a>
    </div>
  </div>
</div>
