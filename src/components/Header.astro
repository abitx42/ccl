---
interface Props {
  lang?: 'en' | 'mr' | 'hi';
}

import { localizedHref, type Locale } from '../lib/i18n';

const { lang = 'mr' } = Astro.props;

const labels = {
  en: {
    title: 'Community Co-creation Lab',
    sub: 'University of Mumbai & British Council',
    home: 'Home',
    districts: 'Districts',
    evidence: 'Evidence & Sources',
    visit: 'Research Access',
    switchLang: 'Language',
    mobileNav: 'Mobile navigation'
  },
  mr: {
    title: 'कम्युनिटी को-क्रिएशन लॅब',
    sub: 'मुंबई विद्यापीठ आणि ब्रिटिश कौन्सिल',
    home: 'मुख्यपृष्ठ',
    districts: 'जिल्हे',
    evidence: 'पुरावे आणि संदर्भ',
    visit: 'अभ्यास भेट परवानगी',
    switchLang: 'भाषा',
    mobileNav: 'मोबाइल नेव्हिगेशन'
  },
  hi: {
    title: 'कम्युनिटी को-क्रिएशन लैब',
    sub: 'मुंबई विश्वविद्यालय और ब्रिटिश काउंसिल',
    home: 'होम',
    districts: 'जिले',
    evidence: 'प्रमाण एवं स्रोत',
    visit: 'शोध पहुंच अनुरोध',
    switchLang: 'भाषा',
    mobileNav: 'मोबाइल नेविगेशन'
  }
};

const t = labels[lang] || labels.en;
const pathname = Astro.url.pathname;

const getLangUrl = (targetLang: Locale) => localizedHref(targetLang, pathname);
const homeUrl = localizedHref(lang, '/');
const districtsUrl = localizedHref(lang, '/#districts');
const sourcesUrl = localizedHref(lang, '/sources');
const visitUrl = localizedHref(lang, '/visit');
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-surface)] sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap lg:flex-nowrap items-center justify-between gap-3 min-h-20 py-3">
      <div class="flex items-center min-w-0 flex-1 lg:flex-none">
        <a href={homeUrl} class="flex flex-col text-decoration-none">
          <span class="text-xl font-bold tracking-tight text-[var(--color-primary)]">
            CCL <span class="text-sm font-medium text-[var(--color-text-muted)]">COOL CRYMB</span>
          </span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">
            {t.sub}
          </span>
        </a>
      </div>

      <nav aria-label={t.title} class="hidden lg:flex items-center gap-5 text-sm font-medium">
        <a href={homeUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] transition">
          {t.home}
        </a>
        <a href={districtsUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] transition">
          {t.districts}
        </a>
        <a href={sourcesUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] transition">
          {t.evidence}
        </a>
        <a href={visitUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] transition">
          {t.visit}
        </a>
      </nav>

      <!-- Language Selector -->
      <div class="flex items-center space-x-2 text-xs border border-[var(--color-border)] rounded-md p-1 bg-[var(--color-surface-subtle)] shrink-0">
        <span class="sr-only">{t.switchLang}</span>
        <a href={getLangUrl('en')} lang="en" hreflang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined} class={`px-2 py-1 rounded font-medium ${lang === 'en' ? 'bg-[var(--color-primary)] text-white' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-main)]'}`}>
          EN
        </a>
        <a href={getLangUrl('mr')} lang="mr" hreflang="mr" aria-label="मराठी" aria-current={lang === 'mr' ? 'page' : undefined} class={`px-2 py-1 rounded font-medium ${lang === 'mr' ? 'bg-[var(--color-primary)] text-white' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-main)]'}`}>
          मराठी
        </a>
        <a href={getLangUrl('hi')} lang="hi" hreflang="hi" aria-label="हिन्दी" aria-current={lang === 'hi' ? 'page' : undefined} class={`px-2 py-1 rounded font-medium ${lang === 'hi' ? 'bg-[var(--color-primary)] text-white' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-main)]'}`}>
          हिन्दी
        </a>
      </div>
    </div>

    <!-- Mobile Navigation Bar (100% static HTML, no JS needed, scrollable on narrow screens) -->
    <nav aria-label={t.mobileNav} class="flex lg:hidden items-center justify-start space-x-6 py-2.5 border-t border-[var(--color-border)] text-xs font-semibold overflow-x-auto">
      <a href={homeUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] whitespace-nowrap transition">
        {t.home}
      </a>
      <a href={districtsUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] whitespace-nowrap transition">
        {t.districts}
      </a>
      <a href={sourcesUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] whitespace-nowrap transition">
        {t.evidence}
      </a>
      <a href={visitUrl} class="text-[var(--color-text-main)] hover:text-[var(--color-primary)] whitespace-nowrap transition">
        {t.visit}
      </a>
    </nav>
  </div>
</header>
