---
import StoryStatic from './StoryStatic.astro';

interface Props {
  lang?: 'en' | 'mr' | 'hi';
}

const { lang = 'en' } = Astro.props;

const narrative = {
  en: {
    skipLink: 'Skip introduction → Explore research',
    viewInteractive: 'Interactive View',
    viewSimple: 'Simple Version',
    b1Title: 'COmmunity cO-creation lab for Local Climate Resilience',
    b1Acronym: 'COOL CRYMB',
    b1Tagline: 'Empowering coastal youth with green skills and co-designing micro-climate solutions in Mumbai and Bristol.',
    b2Heading: 'Why Local Co-Creation Matters',
    b2Problem: 'Coastal Vulnerability: Maharashtra’s coastal ecosystems face severe tidal ingress, riparian erosion, and rising micro-climate heat stress.',
    b2Approach: 'Grassroots Laboratories: Youth-led labs matching community indigenous knowledge with advanced academic climate modeling.',
    b2Outcome: 'Measured Interventions: Practical, low-cost community solutions and accredited green youth livelihoods.',
    b3Heading: 'Bilateral Partnership Architecture',
    b3Text: 'Operated under the British Council’s flagship "Climate Skills – Seeds for Transition India" framework funded by HSBC, this multi-year initiative establishes an active research bridge between the University of Bristol in the United Kingdom and the University of Mumbai in India.',
    b4Heading: 'Academic Lead & Delivery',
    b4Text: 'The Indian research consortium is directed by the Centre for Climate Change and Sustainability Studies (CCCSS) at the University of Mumbai’s Kalina Campus, bringing together higher education institutions, master trainers, and grassroots community groups.',
    b5Heading: 'Five-Step Co-Creation Process',
    b5Steps: [
      { num: '01', title: 'Geographic Targeting', desc: 'Isolating vulnerable river basins and tidal villages.' },
      { num: '02', title: 'Community Profiling', desc: 'Participatory field mapping with elders and cooperatives.' },
      { num: '03', title: 'Social Cartography', desc: 'Hyper-local maps of salinity, vegetation, and flood risks.' },
      { num: '04', title: 'Co-Design Framework', desc: 'Student-led engineering of vegetative bio-shields.' },
      { num: '05', title: 'Field Execution', desc: 'Community implementation and long-term public archiving.' }
    ],
    b6Heading: 'Coastal Research Geography',
    b6Text: 'Research focuses along the Maharashtra coastline. Palghar serves as our technical reference implementation, documenting estuarine salinity patterns and Warli agro-forestry techniques along the Vaitarna basin. Project-scope districts remain under academic verification per the Evidence Register.',
    b6ExploreCta: 'Explore District Research →'
  },
  mr: {
    skipLink: 'प्रास्ताविक वगळा → थेट संशोधन पहा',
    viewInteractive: 'परस्परसंवादी दृश्य',
    viewSimple: 'साधे दृश्य',
    b1Title: 'स्थानिक हवामान लवचिकतेसाठी कम्युनिटी को-क्रिएशन लॅब',
    b1Acronym: 'कूल क्रिम (COOL CRYMB)',
    b1Tagline: 'मुंबई आणि ब्रिस्टलमध्ये किनारपट्टीच्या तरुणांना हरित कौशल्याने सक्षम करणे आणि स्थानिक हवामान उपाययोजनांची निर्मिती करणे.',
    b2Heading: 'स्थानिक सह-निर्मितीचे महत्त्व',
    b2Problem: 'किनारपट्टीवरील आव्हाने: भरतीचे पाणी, किनाऱ्याची धूप आणि वाढते तापमान.',
    b2Approach: 'स्थानिक प्रयोगशाळा: पारंपारिक ज्ञान आणि आधुनिक हवामान विज्ञानाची सांगड.',
    b2Outcome: 'प्रत्यक्ष उपाय: कमी खर्चातील बांध, वृक्षारोपण आणि तरुणांचा कौशल्य विकास.',
    b3Heading: 'द्विपक्षीय संशोधन भागीदारी',
    b3Text: 'ब्रिटिश कौन्सिल आणि एचएसबीसी यांच्या "क्लायमेट स्किल्स - सीड्स फॉर ट्रान्झिशन इंडिया" उपक्रमांतर्गत ब्रिस्टल विद्यापीठ (UK) आणि मुंबई विद्यापीठ यांच्यातील द्विपक्षीय भागीदारी.',
    b4Heading: 'शैक्षणिक नेतृत्व',
    b4Text: 'मुंबई विद्यापीठाच्या कलिना कॅम्पस येथील "सेंटर फॉर क्लायमेट चेंज अँड सस्टेनेबिलिटी स्टडीज" (CCCSS) द्वारे या संशोधन मोहिमेचे संचालन केले जाते.',
    b5Heading: 'पाच-टप्प्यांची सह-निर्मिती प्रक्रिया',
    b5Steps: [
      { num: '०१', title: 'भौगोलिक निवड', desc: 'संवेदनशील खाडी आणि गावांची निवड.' },
      { num: '०२', title: 'समुदाय संवाद', desc: 'स्थानिक शेतकरी व कोळी बांधवांसोबत संवाद.' },
      { num: '०३', title: 'सामाजिक नकाशे', desc: 'क्षारता आणि वनस्पतींचे सूक्ष्म नकाशे.' },
      { num: '०४', title: 'सह-रचना', desc: 'विद्यार्थ्यांद्वारे नैसर्गिक बांधांची रचना.' },
      { num: '०५', title: 'प्रत्यक्ष अंमलबजावणी', desc: 'उपाययोजना आणि कायमस्वरूपी संग्रह.' }
    ],
    b6Heading: 'किनारपट्टी संशोधन भूगोल',
    b6Text: 'महाराष्ट्राच्या किनारपट्टीवर संशोधन सुरू आहे. वैतरणा खोऱ्यातील क्षारता आणि वारली बांध तंत्रज्ञानाच्या अभ्यासासाठी पालघर हे सध्याचे संदर्भ केंद्र आहे. इतर जिल्हे पडताळणी अंतर्गत आहेत.',
    b6ExploreCta: 'जिल्हा संशोधन पहा →'
  },
  hi: {
    skipLink: 'प्रस्तावना छोड़ें → सीधे शोध देखें',
    viewInteractive: 'इंटरैक्टिव दृश्य',
    viewSimple: 'सरल संस्करण',
    b1Title: 'स्थानीय जलवायु लचीलेपन के लिए कम्युनिटी को-क्रिएशन लैब',
    b1Acronym: 'कूल क्रिम (COOL CRYMB)',
    b1Tagline: 'मुंबई और ब्रिस्टल में तटीय युवाओं को हरित कौशल से सशक्त बनाना एवं सूक्ष्म-जलवायु समाधान तैयार करना।',
    b2Heading: 'स्थानीय सह-निर्माण का महत्व',
    b2Problem: 'तटीय चुनौतियां: बढ़ता ज्वार, तटबंध क्षरण और तापमान वृद्धि।',
    b2Approach: 'जमीनी प्रयोगशालाएं: पारंपरिक ज्ञान और आधुनिक विज्ञान का समन्वय।',
    b2Outcome: 'व्यावहारिक परिणाम: कम लागत वाले समाधान और हरित आजीविका विकास।',
    b3Heading: 'द्विपक्षीय अनुसंधान साझेदारी',
    b3Text: 'ब्रिटिश काउंसिल और एचएसबीसी द्वारा समर्थित "क्लाइमेट स्किल्स - सीड्स फॉर ट्रांजिशन इंडिया" कार्यक्रम के तहत ब्रिस्टल विश्वविद्यालय (UK) और मुंबई विश्वविद्यालय के बीच अनुसंधान साझेदारी।',
    b4Heading: 'शैक्षणिक नेतृत्व एवं समन्वय',
    b4Text: 'मुंबई विश्वविद्यालय के कलीना परिसर स्थित सेंटर फॉर क्लाइमेट चेंज एंड सस्टेनेबिलिटी स्टडीज (CCCSS) द्वारा इस शोध नेटवर्क का नेतृत्व किया जाता है।',
    b5Heading: 'पांच-चरणीय सह-निर्माण प्रक्रिया',
