      { num: '02', title: 'सामुदायिक रूपरेखा', desc: 'बुजुर्गों और किसानों के साथ संवाद।' },
      { num: '03', title: 'सामाजिक मानचित्रण', desc: 'लवणता और वनस्पति आवरण का मानचित्रण।' },
      { num: '04', title: 'सह-डिज़ाइन ढांचा', desc: 'छात्रों द्वारा प्राकृतिक मेड़बंदी की रचना।' },
      { num: '05', title: 'क्षेत्रीय क्रियान्वयन', desc: 'कार्यान्वयन और दीर्घकालिक अभिलेखन।' }
    ],
    b6Heading: 'तटीय अनुसंधान भूगोल',
    b6Text: 'अनुसंधान महाराष्ट्र की तटरेखा पर केंद्रित है। पालघर वैतरणा बेसिन में लवणता और वारली वानिकी तकनीकों के अध्ययन के लिए हमारा संदर्भ क्षेत्र है।',
    b6ExploreCta: 'जिला शोध देखें →'
  }
};

const t = narrative[lang] || narrative.en;
---

<section id="ccl-story-container" class="relative bg-[var(--color-bg)] border-b border-[var(--color-border)]">
  <!-- B0: Skip Link (Highest Accessibility Priority) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 flex items-center justify-between">
    <a
      href="#districts"
      class="inline-flex items-center text-xs font-bold text-[var(--color-primary)] hover:underline focus:ring-2 focus:ring-[var(--color-primary)] px-3 py-1.5 rounded-md bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs"
    >
      <span>{t.skipLink}</span>
      <span class="ml-1.5">↓</span>
    </a>

    <!-- Manual Experience Switch (Persists in Session Storage) -->
    <div class="flex items-center space-x-2 text-xs text-[var(--color-text-muted)]">
      <span class="hidden sm:inline font-medium">Mode:</span>
      <button
        id="toggle-mode-btn"
        type="button"
        class="px-2.5 py-1 rounded border border-[var(--color-border)] bg-[var(--color-surface)] text-[11px] font-semibold hover:bg-[var(--color-surface-subtle)] transition"
      >
        <span id="mode-label">{t.viewSimple}</span>
      </button>
    </div>
  </div>

  <!-- Narrative & Visual Grid Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Story Panels (Real Semantic HTML, Zero Client JS Required) -->
      <div id="story-narrative-flow" class="lg:col-span-7 space-y-16">
        
        <!-- B1: Hero Panel -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] mb-4">
            <span>🌱 British Council & HSBC "Seeds for Transition"</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)] tracking-tight">
            {t.b1Acronym}: {t.b1Title}
          </h1>
          <p class="mt-4 text-base text-[var(--color-text-muted)] leading-relaxed">
            {t.b1Tagline}
          </p>
        </article>

        <!-- B2: What & Why Panel -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            Problem & Mission
          </h2>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.b2Heading}
          </h3>
          <div class="space-y-3 text-xs leading-relaxed text-[var(--color-text-muted)]">
            <p><strong class="text-[var(--color-text-main)]">1. Challenge:</strong> {t.b2Problem}</p>
            <p><strong class="text-[var(--color-text-main)]">2. Approach:</strong> {t.b2Approach}</p>
            <p><strong class="text-[var(--color-text-main)]">3. Outcome:</strong> {t.b2Outcome}</p>
          </div>
        </article>

        <!-- B3 & B4: Bilateral Partnership (Who) -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            Academic Consortium
          </h2>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.b3Heading}
          </h3>
          <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
            {t.b3Text}
          </p>
          <div class="pt-3 border-t border-[var(--color-border)]">
            <h4 class="text-sm font-bold text-[var(--color-text-main)] mb-1">{t.b4Heading}</h4>
            <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">{t.b4Text}</p>
          </div>
        </article>

        <!-- B5: How it Works (5 Steps) -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            Methodology
          </h2>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.b5Heading}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {t.b5Steps.map(s => (
              <div class="p-3 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs">
                <span class="font-bold text-[var(--color-primary)] font-mono">{s.num}.</span>
                <strong class="text-[var(--color-text-main)] ml-1">{s.title}:</strong>
                <span class="text-[var(--color-text-muted)] block mt-0.5">{s.desc}</span>
              </div>
            ))}
          </div>
        </article>

        <!-- B6: Where (Held Maharashtra View & Technical Reference Implementation) -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border-2 border-[var(--color-primary)] shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
              Geographic Focus
            </span>
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800">
              Technical Reference Implementation
            </span>
          </div>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.b6Heading}
          </h3>
          <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
            {t.b6Text}
          </p>
          <div class="pt-2">
            <a
              href="#districts"
              class="inline-flex items-center text-xs font-bold text-[var(--color-primary)] hover:underline"
            >
              <span>{t.b6ExploreCta}</span>
              <span class="ml-1">↓</span>
            </a>
          </div>
        </article>

      </div>

      <!-- Right Column: Visual Stage (Sticky Desktop, Static Fallback Default) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 shadow-sm overflow-hidden flex flex-col items-center justify-center min-h-[420px]">
          
          <!-- Tier 4 Static Map (Default / Fallback / No-JS) -->
          <div id="tier4-static-container" class="w-full h-full">
            <StoryStatic lang={lang} />
          </div>

          <!-- Tier 3 Canvas Globe (Progressively Enhanced when JS & 2D Canvas are active) -->
          <div id="tier3-canvas-container" class="w-full h-full hidden flex-col items-center justify-center">
            <canvas id="ccl-2d-globe-canvas" class="max-w-full h-auto cursor-default"></canvas>
            <div class="mt-2 text-[11px] text-[var(--color-text-muted)] text-center font-mono">
              ✦ Tier 3 2D Orthographic Vector Projection
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Client-side Progressive Enhancement Script -->
<script>
  import { GlobeCanvas2D } from './GlobeCanvas2D';

  const container = document.getElementById('ccl-story-container');
  const staticEl = document.getElementById('tier4-static-container');
  const canvasContainer = document.getElementById('tier3-canvas-container');
  const canvas = document.getElementById('ccl-2d-globe-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('toggle-mode-btn');
  const modeLabel = document.getElementById('mode-label');

  // Capability checks
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  const sessionPref = sessionStorage.getItem('ccl-globe-mode');

  let globeInstance: GlobeCanvas2D | null = null;
  let isSimpleMode = prefersReducedMotion || saveData || sessionPref === 'simple';

  function updateModeUI() {
    if (!modeLabel) return;
    modeLabel.textContent = isSimpleMode ? 'Interactive View' : 'Simple Version';
  }

  async function initGlobe() {
    if (isSimpleMode || !canvas || prefersReducedMotion) {
      if (staticEl) staticEl.classList.remove('hidden');
      if (canvasContainer) canvasContainer.classList.add('hidden');
      updateModeUI();
      return;
    }

    try {
      if (staticEl) staticEl.classList.add('hidden');
      if (canvasContainer) canvasContainer.classList.remove('hidden');

      globeInstance = new GlobeCanvas2D(canvas, document.documentElement.lang || 'en');
      await globeInstance.init();
      updateModeUI();

      // Scroll progress tracking via IntersectionObserver & RequestAnimationFrame
      setupScrollListener();
    } catch (err) {
      console.warn('[CCLStory] Tier 3 initialization failed, falling back to static:', err);
      if (staticEl) staticEl.classList.remove('hidden');
      if (canvasContainer) canvasContainer.classList.add('hidden');
    }
  }

  function setupScrollListener() {
    if (!container || !globeInstance) return;

    let ticking = false;

    const onScroll = () => {
      if (!ticking && globeInstance) {
        window.requestAnimationFrame(() => {
          if (!container || !globeInstance) return;
          const rect = container.getBoundingClientRect();
          const totalHeight = container.clientHeight - window.innerHeight;
          const currentY = -rect.top;
          const progress = Math.max(0, Math.min(1, currentY / (totalHeight > 0 ? totalHeight : 1)));

          globeInstance.setProgress(progress);
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Manual switch handler
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isSimpleMode = !isSimpleMode;
      sessionStorage.setItem('ccl-globe-mode', isSimpleMode ? 'simple' : 'interactive');

      if (isSimpleMode) {
        if (globeInstance) {
          globeInstance.destroy();
          globeInstance = null;
        }
        if (staticEl) staticEl.classList.remove('hidden');
        if (canvasContainer) canvasContainer.classList.add('hidden');
      } else {
        initGlobe();
      }
      updateModeUI();
    });
  }

  // Defer initialization until DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobe);
  } else {
    initGlobe();
  }
</script>
