<!-- Client-side Progressive Enhancement Script with Damped Driver Loop & Ambient Audio -->
<script>
  import { GlobeCanvas2D } from './GlobeCanvas2D';
  import { AmbientAudio } from './AmbientAudio';

  const container = document.getElementById('ccl-story-container');
  const staticEl = document.getElementById('tier4-static-container');
  const canvasContainer = document.getElementById('tier3-canvas-container');
  const canvas = document.getElementById('ccl-2d-globe-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('toggle-mode-btn');
  const modeLabel = document.getElementById('mode-label');
  const toggleAudioBtn = document.getElementById('toggle-audio-btn');
  const audioLabel = document.getElementById('audio-label');
  const audioIcon = document.getElementById('audio-icon');

  // Capability checks
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  const sessionPref = sessionStorage.getItem('ccl-globe-mode');

  let globeInstance: GlobeCanvas2D | null = null;
  let isSimpleMode = prefersReducedMotion || saveData || sessionPref === 'simple';

  // Ambient Audio Instance
  const ambientAudio = new AmbientAudio();
  let ambientAudioWanted = false;

  function updateModeUI() {
    if (!modeLabel) return;
    modeLabel.textContent = isSimpleMode ? 'Interactive View' : 'Simple Version';
  }

  function updateAudioUI(isPlaying: boolean) {
    if (!toggleAudioBtn || !audioLabel || !audioIcon) return;
    toggleAudioBtn.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
    if (isPlaying) {
      toggleAudioBtn.classList.add('bg-blue-50', 'text-blue-700', 'border-blue-300');
      audioLabel.textContent = 'Ambient Sound: On';
      audioIcon.textContent = '🎵';
    } else {
      toggleAudioBtn.classList.remove('bg-blue-50', 'text-blue-700', 'border-blue-300');
      audioLabel.textContent = 'Ambient Sound: Off';
      audioIcon.textContent = '🌊';
    }
  }

  // Damped Follow Driver Physics
  // Tunable time constant: 260ms exponential smoothing creates buttery agency drift
  const SMOOTH_MS = 260;
  let rawProgress = 0;
  let renderProgress = 0;
  let rafId: number | null = null;
  let lastTimestamp = 0;
  let isSectionVisible = false;

  function computeRawProgress() {
    if (!container) return;
    const rect = container.getBoundingClientRect();
    const totalHeight = container.clientHeight - window.innerHeight;
    const currentY = -rect.top;
    rawProgress = Math.max(0, Math.min(1, currentY / (totalHeight > 0 ? totalHeight : 1)));
  }

  function driverLoop(timestamp: number) {
    if (!globeInstance || !isSectionVisible) {
      rafId = null;
      return;
    }

    if (!lastTimestamp) lastTimestamp = timestamp;
    const dt = Math.min(timestamp - lastTimestamp, 100);
    lastTimestamp = timestamp;

    computeRawProgress();

    if (prefersReducedMotion) {
      renderProgress = rawProgress;
    } else {
      const alpha = 1 - Math.exp(-dt / SMOOTH_MS);
      renderProgress += (rawProgress - renderProgress) * alpha;
    }

    // Snap to exact position when within micro threshold
    if (Math.abs(rawProgress - renderProgress) < 0.0002) {
      renderProgress = rawProgress;
    }

    globeInstance.setProgress(renderProgress);

    // Keep running if visible
    rafId = window.requestAnimationFrame(driverLoop);
  }

  function startDriver() {
    if (!rafId && isSectionVisible && globeInstance) {
      lastTimestamp = 0;
      rafId = window.requestAnimationFrame(driverLoop);
    }
  }

  function stopDriver() {
    if (rafId) {
      window.cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  async function initGlobe() {
    if (isSimpleMode || !canvas || prefersReducedMotion) {
      if (staticEl) staticEl.classList.remove('hidden');
      if (canvasContainer) canvasContainer.classList.add('hidden');
      updateModeUI();
      return;
    }

    try {
      if (staticEl) staticEl.classList.add('hidden');
      if (canvasContainer) canvasContainer.classList.remove('hidden');

      globeInstance = new GlobeCanvas2D(canvas, document.documentElement.lang || 'en');
      await globeInstance.init();
      updateModeUI();

      setupObserverAndDriver();
    } catch (err) {
      console.warn('[CCLStory] Tier 3 initialization failed, falling back to static:', err);
      if (staticEl) staticEl.classList.remove('hidden');
      if (canvasContainer) canvasContainer.classList.add('hidden');
    }
  }

  function setupObserverAndDriver() {
    if (!container || !globeInstance) return;

    // IntersectionObserver halts RAF polling and ambient audio when section is offscreen
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        isSectionVisible = entry.isIntersecting;
        if (isSectionVisible) {
          startDriver();
          if (ambientAudioWanted) {
            ambientAudio.start();
            updateAudioUI(true);
          }
        } else {
          stopDriver();
          if (ambientAudioWanted) {
            ambientAudio.stop();
          }
        }
      }
    }, { threshold: 0.05 });

    observer.observe(container);

    // Native scroll event updates rawProgress; RAF driver eases toward it
    window.addEventListener('scroll', () => {
      if (!rafId && isSectionVisible) {
        startDriver();
      }
    }, { passive: true });

    // Window resize & orientation change handler
    window.addEventListener('resize', () => {
      if (globeInstance) {
        globeInstance.resize();
      }
      if (!rafId && isSectionVisible) {
        startDriver();
      }
    }, { passive: true });
  }

  // Ambient Audio Button Handler (Opt-in user gesture)
  if (toggleAudioBtn) {
    toggleAudioBtn.addEventListener('click', async () => {
      ambientAudioWanted = !ambientAudioWanted;
      if (ambientAudioWanted) {
        await ambientAudio.start();
        updateAudioUI(true);
      } else {
        ambientAudio.stop();
        updateAudioUI(false);
      }
    });
  }

  // Manual Mode Switch Handler
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isSimpleMode = !isSimpleMode;
      sessionStorage.setItem('ccl-globe-mode', isSimpleMode ? 'simple' : 'interactive');

      if (isSimpleMode) {
        stopDriver();
        if (globeInstance) {
          globeInstance.destroy();
          globeInstance = null;
        }
        if (staticEl) staticEl.classList.remove('hidden');
        if (canvasContainer) canvasContainer.classList.add('hidden');
      } else {
        initGlobe();
      }
      updateModeUI();
    });
  }

  // Defer initialization until DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobe);
  } else {
    initGlobe();
  }
</script>
