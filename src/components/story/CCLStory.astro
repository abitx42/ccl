    s6Eyebrow: 'भौगोलिक केंद्र 02',
    s6Title: 'मुंबई, भारत · कलीना परिसर',
    s6Body: 'मुंबई विश्वविद्यालय के कलीना परिसर स्थित जलवायु परिवर्तन एवं स्थिरता अध्ययन केंद्र (CCCSS) द्वारा संपूर्ण शोध और क्षेत्रीय संचालन का नेतृत्व किया जाता है।',
    s6Sub: 'मुंबई विश्वविद्यालय · CCCSS मुख्य संचालन केंद्र',
    s6Badge: 'Mumbai Institutional Context',

    s7Eyebrow: 'परिसर से सीधे तट तक',
    s7Title: 'विज्ञान को सीधे मुहानों और गांवों तक ले जाना',
    s7Body: 'अनुसंधान केवल कक्षाओं तक सीमित नहीं है। संकाय और छात्र सीधे संवेदनशील मछुआरा बस्तियों और गांवों में जाकर पंचायतों और युवाओं के साथ मिलकर कार्य करते हैं।',
    s7Flow: ['परिसर मॉडलिंग', 'क्षेत्रीय प्रयोगशालाएं', 'सह-डिज़ाइन', 'खुला पुरालेख'],

    s8Eyebrow: 'पांच-चरणीय सह-निर्माण रूपरेखा',
    s8Title: 'एक व्यवस्थित और स्थायी सह-निर्माण प्रक्रिया',
    s8Body: 'प्रत्येक सामुदायिक प्रयोगशाला वैज्ञानिक सटीकता और स्थानीय स्वामित्व सुनिश्चित करने के लिए पांच चरणों का पालन करती है।',
    s8Steps: [
      { num: '01', title: 'क्षेत्र चयन', desc: 'संवेदनशील नदी घाटियों और अधिक लवणता वाले क्षेत्रों की पहचान।' },
      { num: '02', title: 'समुदाय रूपरेखा', desc: 'बुजुर्गों, महिलाओं और युवाओं के साथ मौखिक इतिहास और संवाद।' },
      { num: '03', title: 'स्थानीय मानचित्रण', desc: 'छात्रों द्वारा लवणता, मैंग्रोव आवरण और बाढ़ जोखिम का मानचित्रण।' },
      { num: '04', title: 'सह-डिज़ाइन', desc: 'प्राकृतिक जैव-दीवारों और वर्षा जल संचयन की स्थानीय रचना।' },
      { num: '05', title: 'क्रियान्वयन एवं अभिलेखन', desc: 'जमीनी क्रियान्वयन, निरंतर निगरानी और स्थायी खुला प्रकाशन।' }
    ],

    s9Eyebrow: 'अनुसंधान परिदृश्य',
    s9Title: 'केवल एक वेबसाइट नहीं — एक स्थायी खुला पुरालेख',
    s9Body: 'प्रत्येक अवलोकन एक सत्यापित और अपरिवर्तनीय डेटा रिकॉर्ड के रूप में दर्ज होता है। यह पुरालेख आठ श्रेणियों में व्यवस्थित है:',
    s9Domains: ['गांव/बस्तियां', 'व्यक्ति', 'सर्वेक्षण', 'प्रजातियां', 'चुनौतियां', 'समाधान', 'विरासत', 'साक्ष्य'],

    s10Eyebrow: 'तकनीकी संदर्भ कार्यान्वयन',
    s10Title: 'पालघर तटीय क्षेत्रीय प्रयोगशाला',
    s10Body: 'पालघर इस मंच का संदर्भ तकनीकी कार्यान्वयन है। वैतरणा बेसिन में मुहाना लवणता, पारंपरिक वारली वानिकी और तटीय जैव-दीवारों का यहां अध्ययन किया गया है।',
    s10Badge: 'तकनीकी संदर्भ कार्यान्वयन (अनुसंधान जिले: सत्यापन जारी)',
    technicalReference: 'Technical Reference',
    tier2Label: 'Living 3D Earth · mobile',
    tier3Label: 'Tier 3 2D geographic projection',
    tier1Label: 'Living 3D Earth · natural shading',
    markerBristol: 'Bristol · UK Partner',
    markerMumbai: 'Mumbai · CCCSS context',
    markerPalghar: 'Palghar · Reference Lab',
    diagnostics: { tier: 'Tier', fps: 'FPS', dpr: 'DPR', progress: 'Progress' },

    s11Eyebrow: 'शोध अभिलेख देखें',
    s11Title: 'सत्यापित तटीय अनुसंधान का अन्वेषण करें',
    s11Body: 'प्रकाशित गांवों का विवरण, प्रमाण रजिस्टर, सामुदायिक योगदान और सर्वेक्षण आंकड़े देखें।',
    s11Cta1: 'अनुसंधान पुरालेख देखें ↓',
    s11Cta2: 'शोध पहुंच अनुरोध →'
  }
};

const t = I18N[lang] || I18N.en;
---

<section
  id="ccl-story-container"
  class="relative bg-[var(--color-bg)] border-b border-[var(--color-border)]"
  data-audio-on={t.audioOn}
  data-audio-off={t.audioOff}
  data-view-interactive={t.viewInteractive}
  data-view-simple={t.viewSimple}
  data-tier-one={t.tier1Label}
  data-tier-two={t.tier2Label}
  data-tier-three={t.tier3Label}
>
  <!-- B0: Skip Link & Top Utility Controls -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 flex flex-wrap items-center justify-between gap-4">
    <a
      href="#districts"
      class="inline-flex items-center text-xs font-bold text-[var(--color-primary)] hover:underline focus:ring-2 focus:ring-[var(--color-primary)] px-3 py-1.5 rounded-md bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs"
    >
      <span>{t.skipLink}</span>
      <span class="ml-1.5">↓</span>
    </a>

    <!-- Top Utility Controls: Ambient Audio + Mode Switch + Diagnostics Toggle -->
    <div class="flex items-center space-x-2 text-xs text-[var(--color-text-muted)]">
      <!-- Ambient Coastal Soundscape Toggle -->
      <button
        id="toggle-audio-btn"
        type="button"
        class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[11px] font-semibold hover:bg-[var(--color-surface-subtle)] transition focus:ring-2 focus:ring-[var(--color-primary)] cursor-pointer"
        aria-pressed="false"
        title="Opt-in ambient soundtrack (loops on repeat)"
      >
        <span id="audio-icon" class="text-sm">🌊</span>
        <span id="audio-label">{t.audioOff}</span>
      </button>

      <!-- Visual Mode Switch (Interactive WebGL/2D vs Simple Static) -->
      <button
        id="toggle-mode-btn"
        type="button"
        class="px-3 py-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[11px] font-semibold hover:bg-[var(--color-surface-subtle)] transition focus:ring-2 focus:ring-[var(--color-primary)] cursor-pointer"
      >
        <span id="mode-label">{t.viewSimple}</span>
      </button>

      <!-- Technical Diagnostics Pill -->
      <button
        id="toggle-diag-btn"
        type="button"
        class="hidden sm:inline-flex px-2 py-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[10px] font-mono text-[var(--color-text-muted)] hover:text-[var(--color-text-main)]"
        title="Toggle Performance Diagnostics"
      >
        <span id="diag-pill-text">Tier ?</span>
      </button>
    </div>
  </div>

  <!-- Collapsible Floating Diagnostics Tray -->
  <div
    id="diag-tray"
    class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-2"
  >
    <div class="p-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-[11px] font-mono grid grid-cols-2 sm:grid-cols-4 gap-3 text-[var(--color-text-muted)]">
       <div>{t.diagnostics.tier}: <strong id="diag-tier" class="text-[var(--color-text-main)]">-</strong></div>
       <div>{t.diagnostics.fps}: <strong id="diag-fps" class="text-[var(--color-text-main)]">-</strong></div>
       <div>{t.diagnostics.dpr}: <strong id="diag-dpr" class="text-[var(--color-text-main)]">-</strong></div>
       <div>{t.diagnostics.progress}: <strong id="diag-prog" class="text-[var(--color-text-main)]">0.000 (raw 0.000)</strong></div>
    </div>
  </div>

  <!-- Narrative & Visual Grid Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Story Panels (Real Semantic HTML, Zero Client JS Required) -->
      <div id="story-narrative-flow" class="lg:col-span-7 space-y-20">
        
        <!-- Scene 01: Prologue / Earth -->
        <article id="scene-01" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs transition-opacity duration-300">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] mb-4">
            <span>🌱 {t.s1Eyebrow}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)] tracking-tight">
            {t.s1Title}
          </h1>
          <p class="mt-4 text-base text-[var(--color-text-muted)] leading-relaxed">
            {t.s1Body}
          </p>
          <p class="mt-4 text-xs font-mono text-[var(--color-text-muted)] border-t border-[var(--color-border)] pt-3">
            {t.s1Note}
          </p>
        </article>

        <!-- Scene 02: What is CCL? -->
        <article id="scene-02" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s2Eyebrow}
          </span>
          <h2 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s2Title}
          </h2>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s2Body}
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-2 text-xs">
            {t.s2Triad.map((node, i) => (
              <>
                <span class="px-3 py-1 rounded-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] font-semibold text-[var(--color-text-main)]">
                  {node}
                </span>
                {i < t.s2Triad.length - 1 && <span class="text-[var(--color-text-muted)]">⇄</span>}
              </>
            ))}
          </div>
        </article>

        <!-- Scene 03: Why This Work Matters -->
        <article id="scene-03" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s3Eyebrow}
          </span>
          <h2 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s3Title}
          </h2>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s3Body}
          </p>
          <div class="p-4 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs text-[var(--color-text-main)]">
            ✦ {t.s3Note}
          </div>
        </article>

        <!-- Scene 04: Who We Are (Bilateral Partnership) -->
        <article id="scene-04" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s4Eyebrow}
          </span>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s4Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s4Body}
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            {t.s4Nodes.map((n) => (
              <div class="p-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[11px] font-semibold text-center text-[var(--color-text-main)]">
                {n}
              </div>
            ))}
          </div>
        </article>

        <!-- Scene 05: Bristol (UK Anchor) -->
        <article id="scene-05" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
              {t.s5Eyebrow}
            </span>
            <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-blue-100 text-blue-800">
               {t.s5Badge}
            </span>
          </div>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s5Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s5Body}
          </p>
          <div class="text-xs text-[var(--color-text-muted)] font-mono pt-1">
            {t.s5Sub}
          </div>
        </article>

        <!-- Scene 06: Mumbai (India Anchor) -->
        <article id="scene-06" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
              {t.s6Eyebrow}
            </span>
            <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-red-100 text-red-800">
               {t.s6Badge}
            </span>
          </div>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s6Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s6Body}
          </p>
          <div class="text-xs text-[var(--color-text-muted)] font-mono pt-1">
            {t.s6Sub}
          </div>
        </article>

        <!-- Scene 07: Campus to Coastline -->
        <article id="scene-07" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s7Eyebrow}
          </span>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s7Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s7Body}
          </p>
          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs">
            {t.s7Flow.map((step, i) => (
              <>
                <span class="px-3 py-1 rounded bg-[var(--color-surface-subtle)] border border-[var(--color-border)] font-medium text-[var(--color-text-main)]">
                  {step}
                </span>
                {i < t.s7Flow.length - 1 && <span class="text-[var(--color-text-muted)]">→</span>}
              </>
            ))}
          </div>
        </article>

        <!-- Scene 08: Five-Step Methodology -->
        <article id="scene-08" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s8Eyebrow}
          </span>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s8Title}
          </h3>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            {t.s8Body}
          </p>
          <div class="space-y-3 pt-2">
            {t.s8Steps.map((step) => (
              <div class="flex items-start space-x-4 p-3 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)]">
                <span class="text-sm font-extrabold text-[var(--color-primary)] font-mono">{step.num}</span>
                <div>
                  <h4 class="text-xs font-bold text-[var(--color-text-main)]">{step.title}</h4>
                  <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </article>

        <!-- Scene 09: The Research Landscape -->
        <article id="scene-09" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s9Eyebrow}
          </span>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s9Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s9Body}
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2 text-xs">
            {t.s9Domains.map((dom) => (
              <div class="p-2.5 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-center font-semibold text-[var(--color-text-main)]">
                ✦ {dom}
              </div>
            ))}
          </div>
        </article>

        <!-- Scene 10: Palghar Reference Implementation -->
        <article id="scene-10" class="p-8 rounded-2xl bg-[var(--color-surface)] border-2 border-[var(--color-primary)] shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
              {t.s10Eyebrow}
            </span>
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800">
               {t.technicalReference}
            </span>
          </div>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s10Title}
          </h3>
          <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
            {t.s10Body}
          </p>
          <div class="text-[11px] font-mono text-[var(--color-text-muted)] pt-1">
            {t.s10Badge}
          </div>
        </article>

        <!-- Scene 11: Explore the Archive -->
        <article id="scene-11" class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            {t.s11Eyebrow}
          </span>
          <h3 class="text-2xl font-bold text-[var(--color-text-main)]">
            {t.s11Title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t.s11Body}
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="#districts"
              class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--color-primary)] text-white text-xs font-bold hover:bg-[var(--color-primary-hover)] transition"
            >
              <span>{t.s11Cta1}</span>
            </a>
            <a
              href={localizedHref(lang, '/visit')}
              class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs font-semibold text-[var(--color-text-main)] hover:bg-[var(--color-surface)] transition"
            >
              <span>{t.s11Cta2}</span>
            </a>
          </div>
        </article>

      </div>

      <!-- Right Column: Visual Stage (Sticky Desktop, Multi-Tier Fallback Default) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 shadow-sm overflow-hidden flex flex-col items-center justify-center min-h-[420px]">
          
          <!-- Tier 4 Static Vector Map (Default / Fallback / No-JS) -->
          <div id="tier4-static-container" class="w-full h-full">
            <StoryStatic lang={lang} />
          </div>

          <!-- Tier 3 Canvas 2D Orthographic (Progressive Fallback) -->
          <div id="tier3-canvas-container" class="w-full h-full hidden flex-col items-center justify-center">
            <canvas id="fallback2d" class="max-w-full h-auto cursor-default"></canvas>
            <div class="mt-2 text-[11px] text-[var(--color-text-muted)] text-center font-mono">
               ✦ {t.tier3Label}
            </div>
          </div>

          <!-- Tier 1 & 2 Three.js WebGL Living Earth -->
          <div id="tier1-webgl-container" class="w-full h-full hidden flex-col items-center justify-center">
            <canvas id="gl-canvas" class="max-w-full h-auto cursor-default"></canvas>
            <div class="mt-2 text-[11px] text-[var(--color-text-muted)] text-center font-mono">
               ✦ {t.tier1Label}
            </div>
          </div>

          <!-- DOM Projected Story Anchor Pins Layer (Shared across WebGL & 2D) -->
          <div id="story-marker-layer" class="pointer-events-none absolute inset-0 overflow-hidden">
            <div id="mk-bristol" class="absolute -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200">
              <div class="flex items-center space-x-2 bg-white/95 backdrop-blur-xs px-2.5 py-1 rounded-md shadow-sm border border-blue-200">
                <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                <span class="text-[11px] font-bold text-slate-900">{t.markerBristol}</span>
              </div>
            </div>
            <div id="mk-mumbai" class="absolute -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200">
              <div class="flex items-center space-x-2 bg-white/95 backdrop-blur-xs px-2.5 py-1 rounded-md shadow-sm border border-red-200">
                <span class="w-2 h-2 rounded-full bg-red-600"></span>
                <span class="text-[11px] font-bold text-slate-900">{t.markerMumbai}</span>
              </div>
            </div>
            <div id="mk-palghar" class="absolute -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200">
              <div class="flex items-center space-x-2 bg-white/95 backdrop-blur-xs px-2.5 py-1 rounded-md shadow-sm border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                <span class="text-[11px] font-bold text-slate-900">{t.markerPalghar}</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Client-side Progressive Enhancement Script -->
<script>
  import { STORY_KEYS, type StoryAnchor } from './StoryTypes';
  import type { GlobeWebGL } from './GlobeWebGL';
  import { GlobeCanvas2D } from './GlobeCanvas2D';
  import { AmbientAudio } from './AmbientAudio';

  const container = document.getElementById('ccl-story-container');
  const i18n = {
    audioOn: container?.dataset.audioOn || 'Ambient Sound: On',
    audioOff: container?.dataset.audioOff || 'Ambient Sound: Off',
    viewInteractive: container?.dataset.viewInteractive || 'Interactive View',
    viewSimple: container?.dataset.viewSimple || 'Simple Version',
    tier1Label: container?.dataset.tierOne || 'Tier 1 (WebGL)',
    tier2Label: container?.dataset.tierTwo || 'Tier 2 (WebGL·M)',
    tier3Label: container?.dataset.tierThree || 'Tier 3 (Canvas2D)'
  };
  const staticContainer = document.getElementById('tier4-static-container');
  const canvas2dContainer = document.getElementById('tier3-canvas-container');
  const webglContainer = document.getElementById('tier1-webgl-container');

  const glCanvas = document.getElementById('gl-canvas') as HTMLCanvasElement | null;
  const fallback2dCanvas = document.getElementById('fallback2d') as HTMLCanvasElement | null;

  const toggleBtn = document.getElementById('toggle-mode-btn');
  const modeLabel = document.getElementById('mode-label');
  const toggleAudioBtn = document.getElementById('toggle-audio-btn');
  const audioLabel = document.getElementById('audio-label');
  const audioIcon = document.getElementById('audio-icon');

  const toggleDiagBtn = document.getElementById('toggle-diag-btn');
  const diagTray = document.getElementById('diag-tray');
  const diagPillText = document.getElementById('diag-pill-text');
  const diagTier = document.getElementById('diag-tier');
  const diagFps = document.getElementById('diag-fps');
  const diagDpr = document.getElementById('diag-dpr');
  const diagProg = document.getElementById('diag-prog');

  // Capability & Hardware Checks
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  const isNarrow = window.matchMedia('(max-width: 860px)').matches;
  const sessionPref = sessionStorage.getItem('ccl-globe-mode');

  function checkWebGLSupport() {
    try {
      const c = document.createElement('canvas');
      const gl = c.getContext('webgl2') || c.getContext('webgl') || (c as any).getContext('experimental-webgl');
      if (!gl) return null;
      return { maxTex: gl.getParameter(gl.MAX_TEXTURE_SIZE) };
    } catch (_) {
      return null;
    }
  }

  const wgl = checkWebGLSupport();
  const isWeakDevice = Boolean(
    ((navigator as any).deviceMemory && (navigator as any).deviceMemory < 2) ||
    (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2)
  );

  let currentTier: 1 | 2 | 3 | 4 = 1;
  if (prefersReducedMotion || saveData || sessionPref === 'simple') {
    currentTier = 4;
  } else if (!wgl || wgl.maxTex < 2048 || isWeakDevice) {
    currentTier = 3;
  } else {
    currentTier = isNarrow ? 2 : 1;
  }

  let webglInstance: GlobeWebGL | null = null;
  let canvas2dInstance: GlobeCanvas2D | null = null;
  const ambientAudio = new AmbientAudio();
  let ambientAudioActive = false;

  // Damped Follow Physics Engine
  const SMOOTH_MS = 260; // Tunable time-constant for buttery drift
  let rawProgress = 0;
  let renderProgress = 0;
  let rafId: number | null = null;
  let lastTimestamp = 0;
  let isSectionVisible = false;

  // Story Anchors
  const anchors: StoryAnchor[] = [
    { key: 'bristol', lat: 51.4584, lng: -2.6030, from: 0.49, el: document.getElementById('mk-bristol') },
    { key: 'mumbai', lat: 19.0728, lng: 72.8711, from: 0.59, el: document.getElementById('mk-mumbai') },
    { key: 'palghar', lat: 19.6967, lng: 72.7699, from: 0.92, el: document.getElementById('mk-palghar') }
  ];

  function updateTierUI() {
    const tierName =
      currentTier === 1
        ? i18n.tier1Label
        : currentTier === 2
        ? i18n.tier2Label
        : currentTier === 3
        ? i18n.tier3Label
        : i18n.viewSimple;

    if (diagPillText) diagPillText.textContent = tierName;
    if (diagTier) diagTier.textContent = tierName;
    if (modeLabel) modeLabel.textContent = currentTier === 4 ? i18n.viewInteractive : i18n.viewSimple;
    if (diagDpr) diagDpr.textContent = (window.devicePixelRatio || 1).toFixed(2);
  }

  function computeRawProgress(): number {
    if (!container || prefersReducedMotion) return 0;
    const rect = container.getBoundingClientRect();
    const totalHeight = container.clientHeight - window.innerHeight;
    const currentY = -rect.top;
    return Math.max(0, Math.min(1, currentY / (totalHeight > 0 ? totalHeight : 1)));
  }

  function driverLoop(timestamp: number) {
    if (!isSectionVisible && Math.abs(rawProgress - renderProgress) < 0.0004) {
      rafId = null;
      return;
    }

    if (!lastTimestamp) lastTimestamp = timestamp;
    const dt = Math.min(timestamp - lastTimestamp, 64);
    lastTimestamp = timestamp;

    rawProgress = computeRawProgress();

    if (prefersReducedMotion) {
      renderProgress = rawProgress;
    } else {
      const alpha = 1 - Math.exp(-dt / SMOOTH_MS);
      renderProgress += (rawProgress - renderProgress) * alpha;
    }

    if (Math.abs(rawProgress - renderProgress) < 0.0002) {
      renderProgress = rawProgress;
    }

    // Render to active tier
    if (webglInstance) {
      webglInstance.setProgress(renderProgress);
    } else if (canvas2dInstance) {
      canvas2dInstance.setProgress(renderProgress);
    }

    if (diagProg) {
      diagProg.textContent = `${renderProgress.toFixed(3)} (raw ${rawProgress.toFixed(3)})`;
    }

    rafId = window.requestAnimationFrame(driverLoop);
  }

  function wakeDriver() {
    if (!rafId && isSectionVisible) {
      lastTimestamp = 0;
      rafId = window.requestAnimationFrame(driverLoop);
    }
  }

  function stopDriver() {
    if (rafId) {
      window.cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  async function startWebGLTier() {
    if (!glCanvas) return;
    hideAllTiers();
    if (webglContainer) webglContainer.classList.remove('hidden');

    if (canvas2dInstance) {
      canvas2dInstance.destroy();
      canvas2dInstance = null;
    }

    try {
      const { GlobeWebGL } = await import('./GlobeWebGL');
      webglInstance = new GlobeWebGL(glCanvas, {
        isTier1: currentTier === 1,
        isNarrow,
        anchors,
        keys: STORY_KEYS,
        onDowngrade: () => {
          console.warn('[CCLStory] WebGL frame rate downgraded. Transitioning to Tier 3 2D Canvas.');
          currentTier = 3;
          updateTierUI();
          startCanvas2DTier();
        },
        onFpsUpdate: (fps) => {
          if (diagFps) diagFps.textContent = `${fps} FPS`;
        }
      });
      await webglInstance.init();
      updateTierUI();
      wakeDriver();
    } catch (err) {
      console.warn('[CCLStory] WebGL start error, falling back to Tier 3:', err);
      currentTier = 3;
      updateTierUI();
      startCanvas2DTier();
    }
  }

  async function startCanvas2DTier() {
    if (!fallback2dCanvas) return;
    hideAllTiers();
    if (canvas2dContainer) canvas2dContainer.classList.remove('hidden');

    if (webglInstance) {
      webglInstance.destroy();
      webglInstance = null;
    }

    if (canvas2dInstance) {
      canvas2dInstance.destroy();
      canvas2dInstance = null;
    }

    try {
      canvas2dInstance = new GlobeCanvas2D(fallback2dCanvas, document.documentElement.lang || 'en');
      await canvas2dInstance.init();
      updateTierUI();
      wakeDriver();
    } catch (err) {
      console.warn('[CCLStory] Canvas 2D start error, falling back to static:', err);
      startStaticTier();
    }
  }

  function startStaticTier() {
    hideAllTiers();
    if (staticContainer) staticContainer.classList.remove('hidden');

    if (webglInstance) {
      webglInstance.destroy();
      webglInstance = null;
    }
    if (canvas2dInstance) {
      canvas2dInstance.destroy();
      canvas2dInstance = null;
    }
    stopDriver();
    currentTier = 4;
    updateTierUI();
  }

  function hideAllTiers() {
    if (staticContainer) staticContainer.classList.add('hidden');
    if (canvas2dContainer) canvas2dContainer.classList.add('hidden');
    if (webglContainer) webglContainer.classList.add('hidden');
  }

  function setupIntersectionObserver() {
    if (!container) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          isSectionVisible = entry.isIntersecting;
          if (isSectionVisible) {
            wakeDriver();
            if (ambientAudioActive) {
              ambientAudio.start();
            }
          } else {
            stopDriver();
            if (ambientAudioActive) {
              ambientAudio.stop();
            }
          }
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(container);
  }

  // Event Listeners
  window.addEventListener('scroll', wakeDriver, { passive: true });
  window.addEventListener('resize', () => {
    if (webglInstance) webglInstance.resize();
    if (canvas2dInstance) canvas2dInstance.resize();
    wakeDriver();
  }, { passive: true });

  // Mode Switch
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      if (currentTier === 4) {
        currentTier = wgl && !isWeakDevice ? (isNarrow ? 2 : 1) : 3;
        sessionStorage.setItem('ccl-globe-mode', 'interactive');
        if (currentTier <= 2) startWebGLTier();
        else startCanvas2DTier();
      } else {
        sessionStorage.setItem('ccl-globe-mode', 'simple');
        startStaticTier();
      }
    });
  }

  // Ambient Audio Toggle
  if (toggleAudioBtn) {
    toggleAudioBtn.addEventListener('click', async () => {
      ambientAudioActive = !ambientAudioActive;
      toggleAudioBtn.setAttribute('aria-pressed', ambientAudioActive ? 'true' : 'false');
      if (ambientAudioActive) {
        await ambientAudio.start();
        toggleAudioBtn.classList.add('bg-blue-50', 'text-blue-700', 'border-blue-300');
        if (audioLabel) audioLabel.textContent = i18n.audioOn;
        if (audioIcon) audioIcon.textContent = '🎵';
      } else {
        ambientAudio.stop();
        toggleAudioBtn.classList.remove('bg-blue-50', 'text-blue-700', 'border-blue-300');
        if (audioLabel) audioLabel.textContent = i18n.audioOff;
        if (audioIcon) audioIcon.textContent = '🌊';
      }
    });
  }

  // Diagnostics Tray Toggle
  if (toggleDiagBtn && diagTray) {
    toggleDiagBtn.addEventListener('click', () => {
      diagTray.classList.toggle('hidden');
    });
  }

  // Mount
  function init() {
    setupIntersectionObserver();
    if (currentTier === 4) {
      startStaticTier();
    } else if (currentTier <= 2) {
      startWebGLTier();
    } else {
      startCanvas2DTier();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
