---
import StoryStatic from './StoryStatic.astro';

interface Props {
  lang?: 'en' | 'mr' | 'hi';
}

const { lang = 'en' } = Astro.props;

const narrative = {
  en: {
    skipLink: 'Skip introduction → Explore research',
    viewInteractive: 'Interactive View',
    viewSimple: 'Simple Version',
    audioOff: 'Ambient Sound: Off',
    audioOn: 'Ambient Sound: On',
    b1Title: 'COmmunity cO-creation lab for Local Climate Resilience',
    b1Acronym: 'COOL CRYMB',
    b1Tagline: 'A bilateral research alliance bridging Mumbai and Bristol to empower coastal youth with green skills and co-create hyper-local climate adaptation solutions.',
    b2Heading: 'Who We Are & What We Are',
    b2Sub: 'Decentralized Grassroots Climate Laboratories',
    b2WhoWeAre: 'We are an international collaboration of coastal youth fellows, Warli indigenous knowledge holders, climate researchers, and university scholars. Rather than treating vulnerable coastal villages as passive recipients of external aid, the Community Co-creation Lab (CCL) establishes localized, youth-led field laboratories where scientific atmospheric modeling directly converges with generational ecological wisdom.',
    b2WhatWeAre: 'Operating as an accredited green skills incubator and open-access research archive, we train coastal youth in digital environmental cartography, water salinity testing, and ecological restoration. We measure micro-climate vulnerabilities in real time and co-design low-cost, village-scale resilience interventions.',
    b2Pillar1: 'Youth Leadership: Empowering rural and coastal youth with accredited green skills and environmental monitoring capability.',
    b2Pillar2: 'Indigenous Wisdom: Incorporating Warli agro-forestry, estuarine mangrove protection, and traditional tidal water management.',
    b2Pillar3: 'Durable Interventions: Moving beyond theory to deploy measurable vegetative bio-shields and community rainwater catchments.',
    b3Heading: 'Bilateral Partnership Architecture',
    b3Text: 'Supported by the British Council’s flagship "Climate Skills – Seeds for Transition India" framework funded by HSBC, this multi-year initiative links the University of Bristol in the United Kingdom with the University of Mumbai in India. The bilateral bridge facilitates joint climate modeling, academic peer review, cross-cultural curriculum design, and permanent research preservation.',
    b4Heading: 'Academic Leadership & Field Delivery',
    b4Text: 'Operational leadership is directed by the Centre for Climate Change and Sustainability Studies (CCCSS) at the University of Mumbai’s Kalina Campus. The consortium coordinates university researchers, accredited master trainers, local gram panchayats, and fishing cooperatives to guarantee rigorous scientific methodology, verifiable evidence standards, and strict ethical consent gating for all community participants.',
    b5Heading: 'The Five-Step Co-Creation Lifecycle',
    b5Text: 'Every community resilience initiative progresses through a standardized, five-stage participatory pipeline to ensure scientific validity, local ownership, and long-term sustainability.',
    b5Steps: [
      { num: '01', title: 'Geographic Targeting', desc: 'Isolating vulnerable river basins, tidal estuaries, and high-salinity agricultural zones.' },
      { num: '02', title: 'Community Profiling', desc: 'Participatory oral history collection and field engagement with elders, women, and youth.' },
      { num: '03', title: 'Social Cartography', desc: 'Youth-led GIS mapping of soil salinity, mangrove canopies, water access, and flood risks.' },
      { num: '04', title: 'Participatory Co-Design', desc: 'Student and artisan engineering of vegetative bio-shields, stone bunds, and rainwater catchments.' },
      { num: '05', title: 'Field Execution & Archiving', desc: 'Community implementation, longitudinal sensor monitoring, and permanent open-access data publication.' }
    ],
    b6Heading: 'Coastal Geography & Technical Implementation',
    b6Text: 'Research operations focus along the Maharashtra coastline. Palghar serves as our technical reference implementation, documenting estuarine salinity shifts and Warli indigenous agro-forestry practices in the Vaitarna river basin. Project-wide confirmed research districts remain under formal consortium verification per the Evidence Register.',
    b6ExploreCta: 'Explore District Research Portal →'
  },
  mr: {
    skipLink: 'प्रास्ताविक वगळा → थेट संशोधन पहा',
    viewInteractive: 'परस्परसंवादी दृश्य',
    viewSimple: 'साधे दृश्य',
    audioOff: 'वातावरणीय ध्वनी: बंद',
    audioOn: 'वातावरणीय ध्वनी: सुरू',
    b1Title: 'स्थानिक हवामान लवचिकतेसाठी कम्युनिटी को-क्रिएशन लॅब',
    b1Acronym: 'कूल क्रिम (COOL CRYMB)',
    b1Tagline: 'मुंबई आणि ब्रिस्टल दरम्यान किनारपट्टीच्या तरुणांना हरित कौशल्याने सक्षम करून स्थानिक हवामान उपाययोजनांची सह-निर्मिती करणारा द्विपक्षीय संशोधन मंच.',
    b2Heading: 'आम्ही कोण आहोत आणि आमचे कार्य काय?',
    b2Sub: 'विकेंद्रित स्थानिक हवामान प्रयोगशाळा',
    b2WhoWeAre: 'आम्ही किनारपट्टीवरील तरुण, वारली पारंपारिक ज्ञानधारक, हवामान संशोधक आणि विद्यापीठीय प्राध्यापकांची एक संयुक्त संशोधन फळी आहोत. गावांना केवळ बाह्य मदतीचे घटक न मानता, कम्युनिटी को-क्रिएशन लॅब (CCL) स्थानिक तरुणांच्या नेतृत्वाखाली अशा प्रयोगशाळा उभारते जिथे आधुनिक हवामान विज्ञान आणि पिढ्यानपिढ्यांचे पारंपारिक ज्ञान एकत्र येते.',
    b2WhatWeAre: 'हरित कौशल्य प्रशिक्षण आणि मुक्त संशोधन संग्रहाच्या माध्यमातून आम्ही तरुणांना डिजिटल सामाजिक नकाशे, पाण्याचे क्षारता परीक्षण आणि पर्यावरण संवर्धन शिकवतो. आम्ही स्थानिक समस्यांवर कमी खर्चात टिकाऊ उपाय तयार करतो.',
    b2Pillar1: 'तरुणांचे नेतृत्व: ग्रामीण व किनारपट्टी भागातील तरुणांना अधिकृत हरित कौशल्ये आणि पर्यावरण निरीक्षणाचे प्रशिक्षण.',
    b2Pillar2: 'स्थानिक वारली ज्ञान: कृषी-वनीकरण, खारफुटी संरक्षण आणि पारंपारिक जल व्यवस्थापनाचा प्रत्यक्ष समावेश.',
    b2Pillar3: 'प्रत्यक्ष उपाययोजना: केवळ अहवाल न लिहिता प्रत्यक्ष बांध, वृक्षारोपण आणि जलसंधारण कार्यान्वित करणे.',
    b3Heading: 'द्विपक्षीय संशोधन भागीदारी',
    b3Text: 'ब्रिटिश कौन्सिल आणि एचएसबीसी यांच्या "क्लायमेट स्किल्स - सीड्स फॉर ट्रान्झिशन इंडिया" उपक्रमांतर्गत ब्रिस्टल विद्यापीठ (UK) आणि मुंबई विद्यापीठ यांच्यातील द्विपक्षीय भागीदारी. याद्वारे संयुक्त हवामान प्रारूपे आणि शैक्षणिक आदानप्रदान घडवून आणले जाते.',
    b4Heading: 'शैक्षणिक नेतृत्व आणि प्रत्यक्ष अंमलबजावणी',
    b4Text: 'मुंबई विद्यापीठाच्या कलिना कॅम्पस येथील "सेंटर फॉर क्लायमेट चेंज अँड सस्टेनेबिलिटी स्टडीज" (CCCSS) द्वारे या उपक्रमाचे संचालन केले जाते. विद्यापीठ संशोधक, प्रमाणित मास्टर ट्रेनर्स आणि ग्रामपंचायती यांच्या समन्वयातून नैतिक व पारदर्शक संशोधन केले जाते.',
    b5Heading: 'पाच-टप्प्यांची सह-निर्मिती प्रक्रिया',
    b5Text: 'प्रत्येक स्थानिक उपक्रम शास्त्रीय पद्धतशीरपणा आणि स्थानिक मालकी जपण्यासाठी एका निश्चित पाच टप्प्यांच्या रचनेतून जातो.',
    b5Steps: [
      { num: '०१', title: 'भौगोलिक निवड', desc: 'संवेदनशील खाडी, नद्या आणि क्षारयुक्त शेतजमिनींची निवड.' },
      { num: '०२', title: 'समुदाय संवाद', desc: 'स्थानिक शेतकरी, महिला व ज्येष्ठ नागरिकांशी सविस्तर संवाद.' },
      { num: '०३', title: 'सामाजिक नकाशे', desc: 'तरुणांच्या मदतीने क्षारता, वनस्पती आणि पूर रेषेचे सूक्ष्म नकाशे.' },
      { num: '०४', title: 'सह-रचना व नियोजन', desc: 'विद्यार्थी व स्थानिक कारागिरांद्वारे नैसर्गिक बांध व जलसाठ्यांची रचना.' },
      { num: '०५', title: 'प्रत्यक्ष अंमलबजावणी व संग्रह', desc: 'उपाययोजनांची उभारणी, सातत्यपूर्ण निरीक्षण आणि कायमस्वरूपी मुक्त संग्रह.' }
    ],
    b6Heading: 'किनारपट्टी संशोधन भूगोल',
    b6Text: 'महाराष्ट्राच्या किनारपट्टीवर संशोधन सुरू आहे. वैतरणा खोऱ्यातील क्षारता आणि वारली बांध तंत्रज्ञानाच्या अभ्यासासाठी पालघर हे सध्याचे तांत्रिक संदर्भ केंद्र आहे. उर्वरित जिल्ह्यांची अधिकृत पडताळणी पुरावे नोंदवहीनुसार सुरू आहे.',
    b6ExploreCta: 'जिल्हा संशोधन पोर्टल उघडा →'
  },
  hi: {
    skipLink: 'प्रस्तावना छोड़ें → सीधे शोध देखें',
    viewInteractive: 'इंटरैक्टिव दृश्य',
    viewSimple: 'सरल संस्करण',
    audioOff: 'तटीय ध्वनि: बंद',
    audioOn: 'तटीय ध्वनि: चालू',
    b1Title: 'स्थानीय जलवायु लचीलेपन के लिए कम्युनिटी को-क्रिएशन लैब',
    b1Acronym: 'कूल क्रिम (COOL CRYMB)',
    b1Tagline: 'मुंबई और ब्रिस्टल के बीच तटीय युवाओं को हरित कौशल से सशक्त बनाकर जमीनी जलवायु समाधान विकसित करने वाला द्विपक्षीय अनुसंधान संघ।',
    b2Heading: 'हम कौन हैं और हमारा उद्देश्य क्या है?',
    b2Sub: 'विकेंद्रीकृत स्थानीय जलवायु प्रयोगशालाएं',
    b2WhoWeAre: 'हम तटीय युवाओं, वारली पारंपरिक ज्ञान धारकों, जलवायु वैज्ञानिकों और विश्वविद्यालय शोधकर्ताओं का एक सहयोगात्मक मंच हैं। तटीय गांवों को केवल पीड़ित न मानकर, कम्युनिटी को-क्रिएशन लैब (CCL) स्थानीय युवाओं के नेतृत्व में ऐसी प्रयोगशालाएं स्थापित करती है जहां आधुनिक जलवायु विज्ञान और पीढ़ीगत ज्ञान का मिलन होता है।',
    b2WhatWeAre: 'हरित कौशल प्रशिक्षण और खुले अनुसंधान पुरालेख के माध्यम से हम युवाओं को डिजिटल सामाजिक मानचित्रण, लवणता परीक्षण और पारिस्थितिकी संरक्षण सिखाते हैं। हम स्थानीय स्तर पर प्रभावी और कम लागत वाले अनुकूलन समाधान तैयार करते हैं।',
    b2Pillar1: 'युवा नेतृत्व: तटीय युवाओं को प्रमाणित हरित कौशल और पर्यावरण निगरानी की क्षमता प्रदान करना।',
    b2Pillar2: 'पारंपरिक वारली ज्ञान: मुहाना मैंग्रोव संरक्षण, पारंपरिक मेड़बंदी और मौसमी जल प्रबंधन का एकीकरण।',
    b2Pillar3: 'व्यावहारिक समाधान: सिद्धांतों से आगे बढ़कर वास्तविक प्राकृतिक जैव-ढाल और जल संचयन संरचनाओं की स्थापना।',
    b3Heading: 'द्विपक्षीय अनुसंधान साझेदारी',
    b3Text: 'ब्रिटिश काउंसिल और एचएसबीसी द्वारा समर्थित "क्लाइमेट स्किल्स - सीड्स फॉर ट्रांजिशन इंडिया" पहल के तहत ब्रिस्टल विश्वविद्यालय (UK) और मुंबई विश्वविद्यालय के बीच यह अनुसंधान साझेदारी संचालित है।',
    b4Heading: 'शैक्षणिक नेतृत्व एवं समन्वय',
    b4Text: 'मुंबई विश्वविद्यालय के कलीना परिसर स्थित सेंटर फॉर क्लाइमेट चेंज एंड सस्टेनेबिलिटी स्टडीज (CCCSS) द्वारा इस परियोजना का नेतृत्व किया जाता है। सभी शोध नैतिक सहमति और सत्यापित साक्ष्यों के आधार पर किए जाते हैं।',
    b5Heading: 'पांच-चरणीय सह-निर्माण प्रक्रिया',
    b5Text: 'प्रत्येक पहल स्थानीय स्वामित्व और वैज्ञानिक सटीकता सुनिश्चित करने के लिए एक मानकीकृत पांच-चरणीय रूपरेखा का पालन करती है।',
    b5Steps: [
      { num: '01', title: 'भौगोलिक लक्ष्यीकरण', desc: 'अति-संवेदनशील मुहानों और कृषि क्षेत्रों की वैज्ञानिक पहचान।' },
      { num: '02', title: 'सामुदायिक रूपरेखा', desc: 'बुजुर्गों और युवाओं के साथ मौखिक इतिहास और संवाद।' },
      { num: '03', title: 'सामाजिक मानचित्रण', desc: 'छात्रों द्वारा लवणता, हरित आवरण और जल स्रोतों का मानचित्रण।' },
      { num: '04', title: 'सह-डिज़ाइन ढांचा', desc: 'प्राकृतिक जैव-दीवारों और वर्षा जल संरचनाओं की रचना।' },
      { num: '05', title: 'कार्यान्वयन एवं अभिलेखन', desc: 'जमीनी क्रियान्वयन और स्थायी खुला पुरालेख प्रकाशन।' }
    ],
    b6Heading: 'तटीय अनुसंधान भूगोल',
    b6Text: 'अनुसंधान महाराष्ट्र की तटरेखा पर केंद्रित है। पालघर वैतरणा बेसिन में मुहाना लवणता और पारंपरिक वारली वानिकी के अध्ययन के लिए हमारा तकनीकी संदर्भ कार्यान्वयन है।',
    b6ExploreCta: 'जिला अनुसंधान पोर्टल देखें →'
  }
};

const t = narrative[lang] || narrative.en;
---

<section id="ccl-story-container" class="relative bg-[var(--color-bg)] border-b border-[var(--color-border)]">
  <!-- B0: Skip Link & Top Utility Controls (Highest Accessibility Priority) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 flex flex-wrap items-center justify-between gap-4">
    <a
      href="#districts"
      class="inline-flex items-center text-xs font-bold text-[var(--color-primary)] hover:underline focus:ring-2 focus:ring-[var(--color-primary)] px-3 py-1.5 rounded-md bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs"
    >
      <span>{t.skipLink}</span>
      <span class="ml-1.5">↓</span>
    </a>

    <!-- Top Utility Controls: Ambient Audio + Mode Switch (Persists in Session Storage) -->
    <div class="flex items-center space-x-2 text-xs text-[var(--color-text-muted)]">
      <!-- Ambient Coastal Soundscape Toggle -->
      <button
        id="toggle-audio-btn"
        type="button"
        class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[11px] font-semibold hover:bg-[var(--color-surface-subtle)] transition focus:ring-2 focus:ring-[var(--color-primary)]"
        aria-pressed="false"
        title="Opt-in procedural coastal nature audio (0 KB download, Web Audio API)"
      >
        <span id="audio-icon" class="text-sm">🌊</span>
        <span id="audio-label">{t.audioOff}</span>
      </button>

      <!-- Manual Visual Mode Switch -->
      <button
        id="toggle-mode-btn"
        type="button"
        class="px-3 py-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[11px] font-semibold hover:bg-[var(--color-surface-subtle)] transition focus:ring-2 focus:ring-[var(--color-primary)]"
      >
        <span id="mode-label">{t.viewSimple}</span>
      </button>
    </div>
  </div>

  <!-- Narrative & Visual Grid Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Story Panels (Real Semantic HTML, Zero Client JS Required) -->
      <div id="story-narrative-flow" class="lg:col-span-7 space-y-16">
        
        <!-- B1: Hero Panel -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] mb-4">
            <span>🌱 British Council & HSBC "Seeds for Transition"</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)] tracking-tight">
            {t.b1Acronym}: {t.b1Title}
          </h1>
          <p class="mt-4 text-base text-[var(--color-text-muted)] leading-relaxed">
            {t.b1Tagline}
          </p>
        </article>

        <!-- B2: Problem & Identity: Who We Are & What We Are -->
        <article class="p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
              Core Mission & Identity
            </span>
