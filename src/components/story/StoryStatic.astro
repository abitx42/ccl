---
interface Props {
  lang?: 'en' | 'mr' | 'hi';
}

const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    ukAnchor: 'University of Bristol (UK)',
    mumbaiAnchor: 'University of Mumbai (CCCSS, Kalina)',
    refAnchor: 'Palghar (Technical Reference Implementation)',
    staticNote: 'Accessible Geographic Reference View'
  },
  mr: {
    ukAnchor: 'ब्रिस्टल विद्यापीठ (UK)',
    mumbaiAnchor: 'मुंबई विद्यापीठ (CCCSS, कलिना)',
    refAnchor: 'पालघर (तांत्रिक संदर्भ अंमलबजावणी)',
    staticNote: 'भौगोलिक संदर्भ नकाशा'
  },
  hi: {
    ukAnchor: 'ब्रिस्टल विश्वविद्यालय (UK)',
    mumbaiAnchor: 'मुंबई विश्वविद्यालय (CCCSS, कलीना)',
    refAnchor: 'पालघर (तकनीकी संदर्भ कार्यान्वयन)',
    staticNote: 'भौगोलिक संदर्भ मानचित्र'
  }
};

const t = labels[lang] || labels.en;
---

<div class="relative w-full h-full min-h-[380px] max-h-[500px] flex items-center justify-center p-6 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border)] overflow-hidden">
  <!-- Clean, accessible SVG projection depicting bilateral link & Maharashtra coast -->
  <svg viewBox="0 0 800 500" class="w-full h-full max-w-2xl text-[var(--color-text-main)]" aria-label="Bilateral Research Geography Diagram" role="img">
    <defs>
      <!-- Atmospheric & Oceanic Gradient -->
      <radialGradient id="sphereGrad" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#1E40AF" />
        <stop offset="40%" stop-color="#1D4ED8" />
        <stop offset="85%" stop-color="#0F2C69" />
        <stop offset="100%" stop-color="#08173B" />
      </radialGradient>

      <!-- Atmospheric Halo Gradient -->
      <radialGradient id="haloGrad" cx="50%" cy="50%" r="50%">
        <stop offset="88%" stop-color="#38BDF8" stop-opacity="0.4" />
        <stop offset="96%" stop-color="#0EA5E9" stop-opacity="0.15" />
        <stop offset="100%" stop-color="#0EA5E9" stop-opacity="0" />
      </radialGradient>

      <!-- Lush Terrestrial Vegetation Gradient -->
      <linearGradient id="landGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2D6A4F" />
        <stop offset="50%" stop-color="#40916C" />
        <stop offset="100%" stop-color="#52B788" />
      </linearGradient>

      <!-- 3D Volumetric Lighting Overlay -->
      <radialGradient id="sunShade" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.22" />
        <stop offset="45%" stop-color="#FFFFFF" stop-opacity="0" />
        <stop offset="75%" stop-color="#000A1E" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#000614" stop-opacity="0.65" />
      </radialGradient>
    </defs>

    <!-- Outer Atmospheric Halo Glow -->
    <circle cx="400" cy="250" r="226" fill="url(#haloGrad)" />

    <!-- Globe Sphere Ocean Disc -->
    <circle cx="400" cy="250" r="210" fill="url(#sphereGrad)" stroke="rgba(147, 197, 253, 0.5)" stroke-width="1.5" />

    <!-- Fine Graticule Latitude / Longitude lines -->
    <g stroke="#38BDF8" stroke-width="0.5" opacity="0.22">
      <ellipse cx="400" cy="250" rx="210" ry="80" fill="none" />
      <ellipse cx="400" cy="250" rx="210" ry="160" fill="none" />
      <line x1="190" y1="250" x2="610" y2="250" />
      <line x1="400" y1="40" x2="400" y2="460" />
      <ellipse cx="400" cy="250" rx="100" ry="210" fill="none" />
    </g>

    <!-- Coastal Shelf Buffer (Turquoise coastal fringe) -->
    <!-- Europe / UK -->
    <path d="M 270,140 Q 280,130 295,145 T 285,160 Z" fill="none" stroke="rgba(20, 184, 166, 0.4)" stroke-width="4" />
    <!-- Asia / India Subcontinent -->
    <path d="M 430,210 Q 470,200 490,240 T 465,310 Q 445,350 435,320 T 425,260 Z" fill="none" stroke="rgba(20, 184, 166, 0.4)" stroke-width="4" />

    <!-- Stylized Real Earth Landmasses with Lush Greenery -->
    <!-- Europe / UK -->
    <path d="M 270,140 Q 280,130 295,145 T 285,160 Z" fill="url(#landGrad)" stroke="#1B4332" stroke-width="0.8" />
    <!-- Asia / India Subcontinent -->
    <path d="M 430,210 Q 470,200 490,240 T 465,310 Q 445,350 435,320 T 425,260 Z" fill="url(#landGrad)" stroke="#1B4332" stroke-width="0.8" />

    <!-- Konkan / Western Ghats Coastal Bio-Shield Highlight -->
    <path d="M 425,245 Q 432,255 435,275 T 430,295 Z" fill="#10B981" opacity="0.6" stroke="#059669" stroke-width="1.2" />

    <!-- Bilateral Partnership Great Circle Arc (Static amber dashed line) -->
    <path
      d="M 285,150 Q 360,110 435,270"
      fill="none"
      stroke="#F59E0B"
      stroke-width="2.5"
      stroke-dasharray="5,4"
      opacity="0.9"
    />

    <!-- 3D Volumetric Sunlight Overlay -->
    <circle cx="400" cy="250" r="210" fill="url(#sunShade)" pointer-events="none" />

    <!-- UK Anchor (University of Bristol) -->
    <g transform="translate(285, 150)">
      <circle r="8" fill="rgba(59, 130, 246, 0.3)" />
      <circle r="4" fill="#2563EB" stroke="#FFFFFF" stroke-width="1.5" />
      <rect x="-175" y="-22" width="165" height="18" rx="4" fill="rgba(255, 255, 255, 0.9)" />
      <text x="-12" y="-9" font-size="11" font-weight="bold" fill="#0F172A" text-anchor="end">
        {t.ukAnchor}
      </text>
    </g>

    <!-- India Anchor (University of Mumbai, CCCSS) -->
    <g transform="translate(435, 270)">
      <circle r="8" fill="rgba(239, 68, 68, 0.3)" />
      <circle r="4" fill="#DC2626" stroke="#FFFFFF" stroke-width="1.5" />
      <rect x="10" y="-19" width="220" height="18" rx="4" fill="rgba(255, 255, 255, 0.9)" />
      <text x="16" y="-6" font-size="11" font-weight="bold" fill="#0F172A">
        {t.mumbaiAnchor}
      </text>
    </g>

    <!-- Palghar Field Anchor (Technical Reference Implementation) -->
    <g transform="translate(430, 245)">
      <circle r="7" fill="rgba(16, 185, 129, 0.3)" />
      <circle r="4" fill="#059669" stroke="#FFFFFF" stroke-width="1.5" />
      <rect x="10" y="-8" width="260" height="18" rx="4" fill="rgba(255, 255, 255, 0.9)" />
      <text x="16" y="5" font-size="11" font-weight="bold" fill="#047857">
        ✦ {t.refAnchor}
      </text>
    </g>

    <!-- Map Legend / Note -->
    <text x="400" y="445" font-size="11" fill="var(--color-text-muted)" text-anchor="middle" font-family="system-ui">
      {t.staticNote} · Tier 4 Accessible Vector
    </text>
  </svg>
</div>
