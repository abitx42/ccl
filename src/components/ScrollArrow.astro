---
interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'districts', label = 'Explore Coastal Districts' } = Astro.props;
---

<div class="flex flex-col items-center justify-center my-8">
  <a
    href={`#${targetId}`}
    aria-label={label}
    class="group flex flex-col items-center p-3 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] hover:bg-[var(--color-surface-subtle)] transition shadow-sm focus:ring-2 focus:ring-[var(--color-primary)]"
  >
    <span class="text-xs font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-primary)] mb-1">
      {label}
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 text-[var(--color-primary)] animate-bounce motion-reduce:animate-none"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</div>
