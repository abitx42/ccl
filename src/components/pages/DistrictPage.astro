---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVillages, type District } from '../../lib/content';
import { localizedHref } from '../../lib/i18n';

interface Props {
  district: District;
  lang: 'en' | 'mr' | 'hi';
}

const { district, lang } = Astro.props;
const { slug } = district;

const villages = getVillages(slug!);

const name = district.name[lang] || district.name.en;
const tagline = district.tagline[lang] || district.tagline.en;

const labels = {
  en: {
    zone: 'Coastal research context',
    present: 'Present',
    back: '← Back to Overview',
    communities: 'Studied Villages & Settlements',
    noVillages: 'No public village profiles are published yet for this district.',
    period: 'Research Period',
    coordinates: 'District Geo-Center',
    viewVillage: 'View Field Profile',
    activeLaboratories: 'Active Community Laboratories'
  },
  mr: {
    zone: 'किनारी संशोधन संदर्भ',
    present: 'सध्या सुरू',
    back: '← मुख्यपृष्ठावर परत जा',
    communities: 'अभ्यास केलेली गावे व वस्त्या',
    noVillages: 'या जिल्ह्यासाठी अद्याप कोणतेही सार्वजनिक गाव प्रोफाइल प्रकाशित केलेले नाही.',
    period: 'संशोधन कालावधी',
    coordinates: 'जिल्हा भौगोलिक केंद्र',
    viewVillage: 'गाव प्रोफाइल उघडा',
    activeLaboratories: 'सक्रिय समुदाय प्रयोगशाळा'
  },
  hi: {
    zone: 'तटीय अनुसंधान संदर्भ',
    present: 'वर्तमान',
    back: '← वापस मुख्य पृष्ठ',
    communities: 'अध्ययनित गांव एवं बस्तियां',
    noVillages: 'इस जिले के लिए अभी कोई सार्वजनिक गांव प्रोफ़ाइल प्रकाशित नहीं की गई है।',
    period: 'अनुसंधान अवधि',
    coordinates: 'जिला भू-केंद्र',
    viewVillage: 'ग्राम प्रोफ़ाइल देखें',
    activeLaboratories: 'सक्रिय सामुदायिक प्रयोगशालाएं'
  }
};

const t = labels[lang] || labels.en;

const communityTypes = {
  en: { fishing: 'Fishing', tribal: 'Tribal', farming: 'Farming', mixed: 'Mixed', urban: 'Urban', other: 'Other' },
  mr: { fishing: 'मासेमारी', tribal: 'आदिवासी', farming: 'शेती', mixed: 'मिश्र', urban: 'शहरी', other: 'इतर' },
  hi: { fishing: 'मछुआरा', tribal: 'आदिवासी', farming: 'कृषि', mixed: 'मिश्रित', urban: 'शहरी', other: 'अन्य' }
}[lang] || { fishing: 'Fishing', tribal: 'Tribal', farming: 'Farming', mixed: 'Mixed', urban: 'Urban', other: 'Other' };
---

<BaseLayout title={name} description={tagline} theme={district.theme} lang={lang}>
  <!-- Themed District Hero -->
  <section class="py-16 bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href={localizedHref(lang, '/')} class="text-xs font-semibold text-[var(--color-primary)] hover:underline">
          {t.back}
        </a>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary-light)] text-[var(--color-primary)] mb-3">
             <span>{t.zone}</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--color-text-main)]">
            {name}
          </h1>
          <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed">
            {tagline}
          </p>
        </div>

        <!-- Meta Card -->
        <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] text-xs space-y-3 min-w-[280px]">
          <div>
            <span class="block text-[var(--color-text-muted)] font-medium">{t.period}</span>
             <span class="font-bold text-[var(--color-text-main)]">{district.research_period.start} — {district.research_period.end || t.present}</span>
          </div>
          <div>
            <span class="block text-[var(--color-text-muted)] font-medium">{t.coordinates}</span>
            <span class="font-mono text-[var(--color-text-main)]">{district.coordinates.lat}° N, {district.coordinates.lng}° E</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Communities / Villages Section -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
          {t.activeLaboratories}
        </h2>
        <p class="text-2xl font-extrabold text-[var(--color-text-main)] mt-1">
          {t.communities}
        </p>
      </div>

      {villages.length === 0 ? (
        <div class="p-8 rounded-xl border border-dashed border-[var(--color-border)] text-center text-sm text-[var(--color-text-muted)]">
          {t.noVillages}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {villages.map(v => {
            const vName = v.name[lang] || v.name.en;
            const aboutText = v.about?.documented_source?.[lang] || v.about?.documented_source?.en || '';
            const villageUrl = localizedHref(lang, `/districts/${district.slug}/villages/${v.slug}`);

            return (
              <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="px-2.5 py-0.5 rounded text-xs font-semibold uppercase bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)]">
                       {communityTypes[v.community_type] || v.community_type}
                    </span>
                    <span class="font-mono text-xs text-[var(--color-text-muted)]">
                      {v.id}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-[var(--color-text-main)] mb-2">
                    {vName}
                  </h3>

                  <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4">
                    {aboutText}
                  </p>

                  {v.livelihoods && v.livelihoods.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-6">
                      {v.livelihoods.map(lh => (
                        <span class="px-2 py-0.5 rounded text-[11px] bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text-muted)]">
                          {lh}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <div class="pt-4 border-t border-[var(--color-border)]">
                  <a
                    href={villageUrl}
                    class="inline-flex items-center justify-center w-full px-4 py-2 text-xs font-semibold rounded-lg bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] transition"
                  >
                    <span>{t.viewVillage}</span>
                    <span class="ml-1.5">→</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
