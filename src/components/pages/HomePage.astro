---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CCLStory from '../story/CCLStory.astro';
import StatsCounter from '../StatsCounter.astro';
import DistrictCard from '../DistrictCard.astro';
import { getDistricts } from '../../lib/content';

interface Props {
  lang: 'en' | 'mr' | 'hi';
}

const { lang } = Astro.props;
const districts = getDistricts();

const content = {
  en: {
    pageTitle: 'Home',
    metaDescription: 'A public research archive for local climate resilience, communities, places, and verified field records.',
    partnersTitle: 'Institutional & Funding Partners',
    partnersSub: 'Formal Bilateral Consortium',
    partners: [
      ['University of Mumbai', 'Centre for Climate Change (CCCSS)'],
      ['British Council', 'Climate Skills India Programme'],
      ['HSBC Global CSR', 'Transition Grantor'],
      ['University of Bristol', 'UK Research Partner']
    ],
    districtsEyebrow: 'Research Cartography',
    districtsTitle: 'Explore the CCL Research Archive',
    districtsDesc: 'Navigate verified coastal field laboratories, community audits, and local resilience initiatives.',
    emptyTitle: 'District research profiles are currently undergoing formal academic verification.',
    emptyBody: 'Confirmed coastal field laboratories will be published in accordance with the Evidence Register upon consortium sign-off.'
  },
  mr: {
    pageTitle: 'CCL · स्थानिक हवामान लवचिकता',
    metaDescription: 'स्थानिक हवामान लवचिकता, समुदाय, ठिकाणे आणि सत्यापित क्षेत्रीय नोंदी समजून घेण्यासाठी सार्वजनिक संशोधन संग्रह.',
    partnersTitle: 'संस्थात्मक आणि निधी भागीदार',
    partnersSub: 'अधिकृत द्विपक्षीय संशोधन मंच',
    partners: [
      ['मुंबई विद्यापीठ', 'CCCSS · संस्थात्मक संदर्भ'],
      ['ब्रिटिश कौन्सिल', 'प्रकल्प भागीदार संदर्भ'],
      ['HSBC', 'प्रकल्प नोंदीतील भागीदार संदर्भ'],
      ['ब्रिस्टल विद्यापीठ', 'संशोधन भागीदार संदर्भ']
    ],
    districtsEyebrow: 'संशोधन नकाशा',
    districtsTitle: 'संशोधन संग्रह शोधा',
    districtsDesc: 'सत्यापित ठिकाणे, क्षेत्रीय सर्वेक्षणे, जैवविविधता नोंदी आणि स्थानिक पर्यावरणीय माहिती पाहा.',
    emptyTitle: 'जिल्ह्यांच्या संशोधन नोंदींची औपचारिक पडताळणी सुरू आहे.',
    emptyBody: 'पुराव्याच्या नोंदवहीनुसार आणि संस्थात्मक मंजुरीनंतरच निश्चित क्षेत्रीय नोंदी प्रकाशित केल्या जातील.'
  },
  hi: {
    pageTitle: 'CCL · स्थानीय जलवायु लचीलापन',
    metaDescription: 'स्थानीय जलवायु लचीलापन, समुदायों, स्थानों और सत्यापित क्षेत्रीय रिकॉर्ड का सार्वजनिक शोध पुरालेख।',
    partnersTitle: 'संस्थागत एवं वित्तपोषण भागीदार',
    partnersSub: 'द्विपक्षीय अनुसंधान संघ',
    partners: [
      ['मुंबई विश्वविद्यालय', 'CCCSS · संस्थागत संदर्भ'],
      ['ब्रिटिश काउंसिल', 'परियोजना भागीदार संदर्भ'],
      ['HSBC', 'परियोजना रिकॉर्ड में भागीदार'],
      ['ब्रिस्टल विश्वविद्यालय', 'अनुसंधान भागीदार संदर्भ']
    ],
    districtsEyebrow: 'अनुसंधान मानचित्र',
    districtsTitle: 'अनुसंधान पुरालेख देखें',
    districtsDesc: 'सत्यापित स्थान, क्षेत्रीय सर्वेक्षण, जैव विविधता रिकॉर्ड और स्थानीय पर्यावरणीय जानकारी देखें।',
    emptyTitle: 'जिला अनुसंधान रिकॉर्ड की औपचारिक समीक्षा चल रही है।',
    emptyBody: 'साक्ष्य रजिस्टर और संस्थागत स्वीकृति के बाद ही निश्चित क्षेत्रीय रिकॉर्ड प्रकाशित किए जाएंगे।'
  }
};

const t = content[lang] || content.en;
---

<BaseLayout title={t.pageTitle} description={t.metaDescription} lang={lang}>
  <!-- B0 to B6: Real Semantic HTML Story & Narrative with Tier 3 2D Canvas & Tier 4 Static Vector -->
  <CCLStory lang={lang} />

  <!-- B7: Build-Time Computed Research Statistics (Auto-hidden if 0 verified records) -->
  <StatsCounter lang={lang} />

  <!-- B8: Institutional Partners Logo & Role Strip -->
  <section class="py-16 bg-[var(--color-surface)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)] mb-1">
        {t.partnersSub}
      </h2>
      <p class="text-xl font-extrabold text-[var(--color-text-main)] mb-10">
        {t.partnersTitle}
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center max-w-4xl mx-auto">
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
          <span class="block text-xs font-bold text-[var(--color-text-main)]">{t.partners[0][0]}</span>
          <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">{t.partners[0][1]}</span>
        </div>
        {t.partners.slice(1).map(([name, role]) => (
          <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)]">
            <span class="block text-xs font-bold text-[var(--color-text-main)]">{name}</span>
            <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">{role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- B9: District Selector Section (Real HTML <a> Links, Data-Driven, Zero Hardcoded Counts) -->
  <section id="districts" class="py-20 bg-[var(--color-bg)] scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold tracking-widest text-[var(--color-primary)]">{t.districtsEyebrow}</h2>
        <p class="mt-2 text-3xl font-extrabold text-[var(--color-text-main)]">{t.districtsTitle}</p>
        <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">{t.districtsDesc}</p>
      </div>

      <!-- Data-driven district grid (Never hard-coded; gracefully handles zero confirmed districts) -->
      {districts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {districts.map(d => (
            <DistrictCard district={d} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="text-center p-12 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] max-w-2xl mx-auto space-y-3">
          <p class="text-sm font-semibold text-[var(--color-text-main)]">
             {t.emptyTitle}
          </p>
          <p class="text-xs text-[var(--color-text-muted)]">
             {t.emptyBody}
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
