---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import type { Evidence } from '../../lib/content';

interface Props {
  lang: 'en' | 'mr' | 'hi';
}

const { lang } = Astro.props;

const evidenceDir = path.resolve(process.cwd(), 'content/evidence');
const claims: Evidence[] = [];
if (fs.existsSync(evidenceDir)) {
  const files = fs.readdirSync(evidenceDir).filter(f => f.endsWith('.yaml') || f.endsWith('.yml'));
  for (const f of files) {
    const data = yaml.load(fs.readFileSync(path.join(evidenceDir, f), 'utf-8')) as Evidence;
    if (data && data.state === 'verified') {
      claims.push(data);
    }
  }
}

const titles = {
  en: {
    pageTitle: 'Evidence & Sources',
    description: 'Verified evidence claims and source references published in the CCL research archive.',
    heading: 'Evidence Register & Verified Sources',
    sub: 'Per docs/10-EVIDENCE-REGISTER.md, every factual claim on this platform must be traced to a verifiable source. Unverified claims are withheld.',
    claimHeader: 'Claim Statement',
    typeHeader: 'Evidence Type',
    sourceHeader: 'Primary Source Reference',
    verifierHeader: 'Verified By & Date',
    tableCaption: 'Verified evidence claims published in this build',
    fieldReviewer: 'Field Reviewer',
    evidenceTypes: { official_document: 'Official document', academic_publication: 'Academic publication', field_survey: 'Field survey', interview: 'Interview', community_account: 'Community account', photographic_evidence: 'Photographic evidence', geospatial_dataset: 'Geospatial dataset', government_dataset: 'Government dataset', institutional_record: 'Institutional record', researcher_observation: 'Researcher observation', secondary_source: 'Secondary source' }
  },
  mr: {
    pageTitle: 'पुरावे आणि संदर्भ',
    description: 'CCL संशोधन संग्रहातील सत्यापित पुरावे आणि त्यांच्या संदर्भांची नोंद.',
    heading: 'पुरावे नोंदवही आणि सत्यापित संदर्भ',
    sub: 'या संकेतस्थळावरील प्रत्येक तथ्याची नोंद अधिकृत पुराव्यासह केली जाते. असत्यापित माहिती प्रसिद्ध केली जात नाही.',
    claimHeader: 'दावा / विधान',
    typeHeader: 'पुराव्याचा प्रकार',
    sourceHeader: 'मूळ संदर्भ',
    verifierHeader: 'सत्यापनकर्ता व तारीख',
    tableCaption: 'या बिल्डमध्ये प्रकाशित सत्यापित पुरावे',
    fieldReviewer: 'क्षेत्रीय पडताळणी करणारे',
    evidenceTypes: { official_document: 'अधिकृत दस्तऐवज', academic_publication: 'शैक्षणिक प्रकाशन', field_survey: 'क्षेत्रीय सर्वेक्षण', interview: 'मुलाखत', community_account: 'समुदायाचा अनुभव', photographic_evidence: 'छायाचित्र पुरावा', geospatial_dataset: 'भौगोलिक माहिती संच', government_dataset: 'शासकीय माहिती संच', institutional_record: 'संस्थात्मक नोंद', researcher_observation: 'संशोधकाचे निरीक्षण', secondary_source: 'दुय्यम संदर्भ' }
  },
  hi: {
    pageTitle: 'प्रमाण एवं स्रोत',
    description: 'CCL शोध पुरालेख में प्रकाशित सत्यापित प्रमाण और स्रोत संदर्भ।',
    heading: 'प्रमाण रजिस्टर एवं सत्यापित स्रोत',
    sub: 'इस प्लेटफॉर्म पर प्रत्येक तथ्य को सत्यापित स्रोत से जोड़ा जाता है। असत्यापित दावों को प्रकाशित नहीं किया जाता।',
    claimHeader: 'कथन / दावा',
    typeHeader: 'साक्ष्य प्रकार',
    sourceHeader: 'प्राथमिक स्रोत',
    verifierHeader: 'सत्यापनकर्ता एवं तिथि',
    tableCaption: 'इस बिल्ड में प्रकाशित सत्यापित प्रमाण',
    fieldReviewer: 'क्षेत्रीय समीक्षक',
    evidenceTypes: { official_document: 'आधिकारिक दस्तावेज', academic_publication: 'शैक्षणिक प्रकाशन', field_survey: 'क्षेत्रीय सर्वेक्षण', interview: 'साक्षात्कार', community_account: 'सामुदायिक विवरण', photographic_evidence: 'फोटोग्राफिक प्रमाण', geospatial_dataset: 'भू-स्थानिक डेटा', government_dataset: 'सरकारी डेटा', institutional_record: 'संस्थागत रिकॉर्ड', researcher_observation: 'शोधकर्ता का अवलोकन', secondary_source: 'द्वितीयक स्रोत' }
  }
};

const t = titles[lang] || titles.en;
const evidenceTypes = t.evidenceTypes as Record<string, string>;
---

<BaseLayout title={t.pageTitle} description={t.description} lang={lang}>
  <section class="py-16 bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-main)]">
          {t.heading}
        </h1>
        <p class="mt-4 text-sm text-[var(--color-text-muted)] leading-relaxed">
          {t.sub}
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-xs">
         <table class="min-w-full divide-y divide-[var(--color-border)] text-xs text-left">
           <caption class="sr-only">{t.tableCaption}</caption>
          <thead class="bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] uppercase tracking-wider font-semibold">
            <tr>
              <th scope="col" class="px-6 py-3 font-mono">ID</th>
              <th scope="col" class="px-6 py-3">{t.claimHeader}</th>
              <th scope="col" class="px-6 py-3">{t.typeHeader}</th>
              <th scope="col" class="px-6 py-3">{t.sourceHeader}</th>
              <th scope="col" class="px-6 py-3">{t.verifierHeader}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)] text-[var(--color-text-main)]">
            {claims.map(c => {
              const claimText = c.claim[lang] || c.claim.en;

              return (
                <tr class="hover:bg-[var(--color-surface-subtle)] transition">
                  <td class="px-6 py-4 font-mono font-semibold text-[var(--color-primary)] whitespace-nowrap">
                    {c.id}
                  </td>
                  <td class="px-6 py-4 max-w-md font-medium leading-relaxed">
                    {claimText}
                  </td>
                   <td class="px-6 py-4">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-800 border border-blue-200">
                      {evidenceTypes[c.type] || c.type.replace(/_/g, ' ')}
                    </span>
                  </td>
                   <td class="px-6 py-4 font-mono text-[var(--color-text-muted)] break-words">
                    {c.source} {c.method && `(${c.method})`}
                  </td>
                   <td class="px-6 py-4 text-[var(--color-text-muted)]">
                     <span class="block font-medium text-[var(--color-text-main)]">{c.verified_by || t.fieldReviewer}</span>
                    <span class="text-[11px] font-mono">{c.verified_on || '2026'}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
